function on_message(self, message_id, message, sender)
	if message_id == hash("player_idle") then 
		self.input={left= false, right = false ,down=false, up = false, roll = false}
		sprite.play_flipbook("Pl_Sprite#plr","idle")
	
	end
	if message_id == hash("player_dead") then
		sprite.play_flipbook("Pl_Sprite#plr","dead")
		--self.prev_state = "dead"
		--self.cur_anim = "dead"
		--print("this shit ran")
		--self.cur_anim = "dead"
	end
	if message_id == hash("right_dir_change") then 
		self.input.right = message.dir 
	elseif message_id ==  hash("left_dir_change") then 
		self.input.left = message.dir 
	elseif message_id ==  hash("up_dir_change") then 
		self.input.up = message.dir
	elseif message_id ==  hash("down_dir_change") then 
		self.input.down = message.dir
	elseif message_id ==  hash("dash") then 
		self.dashing  = message.dash
	elseif message_id == hash("dash_end") then 
		self.dashing  = false
		--print("DASH ENDED ")
		self.prev_state = "walk"
		self.cur_anim = "walk"
		timer.delay(0.3, false, function()
			if Pstate.alive then
				sprite.play_flipbook("Pl_Sprite#plr",self.cur_anim )
			end
		end
		)
		
	end
	if message_id == hash("trigger_response") and not Pstate.immunity_frame and message.other_group == hash("bullet_box") and Pstate.alive  then 
		if not self.immunity then
			msg.post(message.other_id,"player_hit",{data = 6767})
			self.immunity = true 
			timer.delay(0.5,false, function() 
				self.immunity = false
			end)
			
		end
	elseif message_id == hash("trigger_response") and Pstate.immunity_frame then 
		sfx("IW_dashdodge")
		local graphic = factory.create("/global#quick_graphic",go.get_position(".")+vmath.vector3(0,6,10))
		msg.post(graphic,"spawn",{graphic = "dash",duration = 0.5 })
		
	end
	if message_id == hash("heart_pickup") then
		if Pstate.health < Pstate.max_health then
			Pstate.health = Pstate.health + ( 0.5 + upgrades.data_layer["+heart"].health)
			if Pstate.health > Pstate.max_health then
				Pstate.health = Pstate.max_health
			end
			msg.post("/Gui_collection/hud#hud","health_bar_change",{health = Pstate.health , max_health = Pstate.max_health})
		end
	end 
	if message_id == hash("Hit_response") then 
		if math.random() >  upgrades.data_layer["dodge"].chance  then
			if upgrades.data_layer["shield"].owns == 1 and upgrades.data_layer["shield"].active == 1 then
				upgrades.data_layer["shield"].active = 0
				local graphic = factory.create("/global#quick_graphic",go.get_position(".")+vmath.vector3(0,6,10))
				sfx("IW_shieldbreak")
				msg.post(graphic,"spawn",{graphic = "shield",duration = 1.5 })
			else
			
			Pstate.health = Pstate.health - 1
			sound.stop("/Sound_manager#Pl_hit_sfx")
			sound.play("/Sound_manager#Pl_hit_sfx")
			msg.post("/Gui_collection/hud#hud","health_bar_change",{health = Pstate.health , max_health = Pstate.max_health})
				if settings.screen_shake then
					msg.post("/Player_ROOT/camera#camera_script","screen_shake",{strenght  = 10})
				end
				if Pstate.health <= 0 then 
					sprite.play_flipbook("Pl_Sprite#plr","dead")
					Pstate.alive = false
					particlefx.play("Pl_Sprite#player_death")
					msg.post("/global#Game_state_manager","change_state",{state = "dead"})
				end
			end
		else
			local graphic = factory.create("/global#quick_graphic",go.get_position(".")+vmath.vector3(0,6,10))
			sfx("IW_dodge")
			msg.post(graphic,"spawn",{graphic = "dodge",duration = 3 })
		end
	end
	
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

