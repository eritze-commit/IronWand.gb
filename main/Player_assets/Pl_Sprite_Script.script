local settings = require("main.GLOBAL.settings_data")
local Pstate = require "main.Player_assets.Player_state_module"
local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
local game_state = require("main.GLOBAL.in_game")

local function sfx(sfx)
	local s_s_max = 1.5
	local s_s_min = 0.5
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	sound.play("/Sound_manager#"..sfx,{speed = random_offset })
end

function init(self)
	--msg.post(".", "acquire_input_focus")
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
	self.input={left= false, right = false ,down=false, up = false, roll = false}
	self.prev_state = ""
	self.state = ""
	self.cur_anim = ""
	self.vertical = nil
	self.dashing = false
	self.max = Pstate.health 
	self.immunity = false
	self.immunity_frame_time = 0.3
	
	
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end
local last_own = 0 
local last_active = 0 

function update(self, dt)
	if last_own ~= upgrades.data_layer["shield"].owns then 
		last_own = upgrades.data_layer["shield"].owns
		if upgrades.data_layer["shield"].owns ~= 1 then
			sprite.play_flipbook("Pl_Sprite#shield","empty")
			upgrades.data_layer["shield"].active = 0
		else
			upgrades.data_layer["shield"].active = 1 
			upgrades.data_layer["shield"].buffer = upgrades.data_layer["shield"].max_recharge
		end
	end
	if last_active ~= upgrades.data_layer["shield"].active then
		last_active = upgrades.data_layer["shield"].active
		if upgrades.data_layer["shield"].active == 1 and upgrades.data_layer["shield"].owns == 1  then
			sprite.play_flipbook("Pl_Sprite#shield","rotating")
		else
			sprite.play_flipbook("Pl_Sprite#shield","empty")
		end
	end
	local camera_pos = go.get_position(".")

	local pl_pos =  go.get_position("Player")
	--local x_y = vmath.vector3(pl_pos.x,pl_pos.y,730)

	local new_pos = vmath.lerp(0.4,camera_pos,pl_pos)
	
	--print(self.input.down)
	go.set_position(new_pos, ".")

	
	if self.input.right then 
		self.vertical = false
		self.prev_state = "right"
		self.cur_anim = "walk"
	end
	if self.input.left then 
		self.vertical = true
		self.prev_state = "left"
		self.cur_anim = "walk"
	end
	if self.input.down then 
		self.prev_state = "down"
		self.cur_anim = "walk"
	end
	if self.input.up then 
		self.prev_state = "up"
		self.cur_anim = "walk"
	end
	
	if not self.input.left and not self.input.right and not self.input.up and not self.input.down then 

		self.prev_state = "idle"
		self.cur_anim = "idle"
	else
		--self.prev_state = "walk"
	end
	if self.dashing then 
		sprite.play_flipbook("Pl_Sprite#plr","dash" )
	end
	if self.state ~= self.prev_state and not self.dashing  then
		if Pstate.alive then
			sprite.play_flipbook("Pl_Sprite#plr",self.cur_anim )
			self.state = self.prev_state
		end
	end
	
	sprite.set_hflip("Pl_Sprite#plr", self.vertical)

	
	
end

