local dash_init = false
local last_position = vmath.vector3()

function on_message(self, message_id, message, sender)
	if message_id == hash("dsh_trg") then 
		dash_init = message.dashing
		last_position = message.lst_pos
		print(dash_init,last_position)
		timer.delay(message.time,false,
		function()
			dash_init = false
		end
	)
		
		--print("got message")
	end
	if message_id ==  hash("contact_point_response") then
		
		if message.other_group == hash("wall") then
				--print("colided with wall ")
				--local next_pos = vmath.lerp(0.01,last_position,self.pos)
				--_Ggo.set_position(next_pos, ".")
				local self_pos = go.get_position("Player")
				if 	message.distance >= 0 then
					local target_pos  = self_pos + -Pstate.player_dir  * (message.distance * 2)
					go.set_position( target_pos, "Player")  
					msg.post("Player","Dsh_response",{dsh = false,normal = message.normal, distance = message.distance, my_pos =  self_pos}) 
					-- local cur_pos = go.get_position("Player")
					-- --go.set_position( cur_pos , "Player")
					-- local target_pos  = cur_pos + message.normal * message.distance 
					--go.animate("Player", "position", go.PLAYBACK_ONCE_FORWARD ,target_pos , go.EASING_INOUTSINE, 0.15, 0,function()
					--	dash_init = false
					--end)
					--self.dir = vmath.vector3(0,0,0)
					--go.set_position(resolved, ".")
					--	end
					--end
			end
		end
	end
end

