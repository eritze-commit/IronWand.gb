local mouse_cords = vmath.vector3()



local gun_rot_delay = 0.3
function update(self, dt)
	if Pstate.alive then
		if not game_state.paused then 
	if vmath.length(self.gun_dir) > 0 then 
		if vmath.length(self.gun_dir) > 0 then 
			self.gun_dir = vmath.normalize(self.gun_dir)
		end
		local deg = ( math.atan2(self.gun_dir.y,self.gun_dir.x)) * (180 / math.pi)
		if deg < 0 then 
			deg = deg + 360
		end 
		local rounded_deg = math.floor(deg / 45 + 0.5) * 45
		--print("DEGREEES ",math.floor(deg),"CORDINGATES",self.gun_dir) 
		if self.gun_state[rounded_deg] then 
			self.cur_state = rounded_deg 

		end
	end
	
	if self.cur_state ~= self.prev_state and not self.reload_timer  then 
		self.prev_state = self.cur_state
		-- if self.input_polls.right then 
		-- 	self.rot = self.rot - 45
		-- 	
		-- 	if  self.rot < -360 then 
		-- 		self.rot = 0
		-- 		self.rot = self.rot - 45
		-- 	end
		-- 	vmath.vector3()
		-- 	
		-- 	--go.set_rotation(vmath.quat_rotation_z(math.rad(self.rot)), ".") 
		-- 	go.animate(".","rotation",go.PLAYBACK_ONCE_FORWARD,vmath.quat_rotation_z(math.rad(self.rot)),go.EASING_OUTBACK,gun_rot_delay )
		-- end
		-- if self.input_polls.left then 
		-- 	self.rot = self.rot + 45
		-- 	if self.rot > 360 then
		-- 		self.rot = 0
		-- 		self.rot = self.rot + 45
		-- 	end
		-- 	--go.set_rotation(vmath.quat_rotation_z(math.rad(self.rot)), ".") 
		-- 	go.animate(".","rotation",go.PLAYBACK_ONCE_FORWARD,vmath.quat_rotation_z(math.rad(self.rot)),go.EASING_OUTBACK,gun_rot_delay )
		-- end
		
		--print("CUR SELF DEGREEES " , self.rot)
		--vmath.quat_rotation_z(math.rad(self.rot))
		self.last_rotate = self.rot
		local current_rot = go.get(".","euler.z")
		self.rot = self.cur_state
		go.animate(".","euler.z",go.PLAYBACK_ONCE_FORWARD,current_rot + ((self.rot - current_rot + 180 )%360-180) ,go.EASING_OUTBACK,0.2 )
		if self.focus_on_gun then
			local cur_dir_rad = math.rad(self.rot)
			local focus_dir = vmath.vector3(
			math.cos(cur_dir_rad),
			math.sin(cur_dir_rad),
			0) 
			msg.post("camera#camera_script","gun_focus",{focus = true , dir =  focus_dir, sound_manager = go.get_id("Sound_manager") })
		end
		if self.gun_state[self.rot] ~= nil then 
			sprite.set_vflip(self.gun_state[self.rot].slot, self.gun_state[self.rot].flip)
			self.cur_z = self.gun_state[self.rot].z_order
		end
		self.input_polls.right = false
		self.input_polls.left = false
	end

	--print(self.csp)
	
	local my_pos = go.get_position(".")
	local pl_pos =  go.get_position("Pl_Sprite")
	
	local x_y = vmath.vector3(pl_pos.x,pl_pos.y,self.cur_z)

	local new_pos = vmath.lerp(0.4,my_pos,x_y)
	
	go.set_position(new_pos, ".")
	self.cur_pos = pl_pos
			
end
end
