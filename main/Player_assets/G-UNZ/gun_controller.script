local mouse_cords = vmath.vector3()
local function mag_display_switch(self) 
	if self.cur_gun == 1 then
		return "INF" 
	else
		return self.second_gun_mags
	end
end
local function display_gun(self) 
		sprite.play_flipbook("gun_cont#slot", self.gun_master_list[ self.gun_swap[self.cur_gun] ].gun_name )
			gun_state.gun_name = self.gun_master_list[ self.gun_swap[self.cur_gun] ].gun_name
			gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
			gun_state.gun_max_mag  =  mag_display_switch(self) --self.second_gun_mags --self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
end

local gun_rot_delay = 0.3
local gun_rel_delay = 0.15
function update(self, dt)
	--print( self.clipping_flag )
	
	--self.clipping_flag = false
	
	-- if next(self.clipped_items) == nil then 
	-- 	self.clipped = false
	-- else
	-- 	self.clipped = true 
	-- end
	--self.clipped = false
	
	if upgrades.data_layer["2gun"].gun_name ~= self.last_gun_name_2 then
		self.last_gun_name_2 =  upgrades.data_layer["2gun"].gun_name
		self.second_gun_mags = 5
		if self.cur_gun == 2 then 
			display_gun(self)
		end

	end
	if upgrades.data_layer["1gun"].gun_name ~= self.last_gun_name_1 then
		self.last_gun_name_1 =  upgrades.data_layer["1gun"].gun_name
		if self.cur_gun == 1 then
			display_gun(self)
		end

	end
	-- if next(self.clipped_items) == nil then 
	-- 	self.clipped = false
	-- else
	-- 	self.clipped = true 
	-- end
	if Pstate.alive then
		if game_state.paused then 
			if self.reload_timer then 
				go.cancel_animations(".","euler.z")
				self.reload_timer = false
				go.set(go.get_id(),"euler.z", self.rot) 
			end
		elseif not  game_state.paused then 
			
			if self.gun_1_delay and self.cur_gun == 1 then 
				self.gun_1_timer = self.gun_1_timer - dt
				if self.gun_1_timer <= 0 then
					--print("RUN THIS SHIT ")
					self.gun_1_delay = false
				end
			end
			if self.gun_2_delay and self.cur_gun == 2 then 
				self.gun_2_timer = self.gun_2_timer - dt
				if self.gun_2_timer <= 0 then
					self.gun_2_delay = false
				end
			end
		end
		--self.clipped = true  
		if self.last_update_gun2 ~= upgrades.data_layer["2gun"].has_gun then
			if upgrades.data_layer["2gun"].has_gun ~= 0 then
				self.last_update_gun2 = upgrades.data_layer["2gun"].has_gun
				self.max_gun = 2 
				self.second_gun_mags = 5 
				if self.cur_gun == 2 then
					display_gun(self)
				end
			--	 print("GUN THING RAN ")
				 --pprint(self.gun_master_list[ self.gun_swap[2] ])
			else
				self.last_update_gun2 = upgrades.data_layer["2gun"].has_gun
				self.max_gun = 1
				if self.cur_gun == 2 then
					self.cur_gun = 1 
					display_gun(self)
				end
			end
		end
		if self.last_update_gun1 ~= upgrades.data_layer["1gun"].has_gun then
			if upgrades.data_layer["1gun"].has_gun ~= 0 then
				self.last_update_gun1 = upgrades.data_layer["1gun"].has_gun
				self.gun_swap[1] = "1gun"
				if self.cur_gun == 1 then 
					display_gun(self)
				end
				--self.max_gun = 2 
			--	 print("GUN THING RAN ")
				 --pprint(self.gun_master_list[ self.gun_swap[1] ])
			else
				self.last_update_gun1 = upgrades.data_layer["1gun"].has_gun
				self.gun_swap[1] = "pistol"
			if self.cur_gun == 1 then 
					display_gun(self)
			end

				
				--self.max_gun = 1 
			end

		end
		if not game_state.paused then 
	if vmath.length(self.gun_dir) > 0 then 
		if vmath.length(self.gun_dir) > 0 then 
			self.gun_dir = vmath.normalize(self.gun_dir)
		end
		local deg = ( math.atan2(self.gun_dir.y,self.gun_dir.x)) * (180 / math.pi)
		if deg < 0 then 
			deg = deg + 360
		end 
		local rounded_deg = math.floor(deg / 45 + 0.5) * 45
		--print("DEGREEES ",math.floor(deg),"CORDINGATES",self.gun_dir) 
		if self.gun_state[rounded_deg] then 
			self.cur_state = rounded_deg 

		end
	end
	
--	go.set("bullet_casing","position",go.get_world_position("target_trig"))
	if self.cur_state ~= self.prev_state and not self.reload_timer  then 
		self.prev_state = self.cur_state
		
		self.last_rotate = self.rot
		local current_rot = go.get(".","euler.z")
		self.rot = self.cur_state
		go.animate(".","euler.z",go.PLAYBACK_ONCE_FORWARD,current_rot + ((self.rot - current_rot + 180 )%360-180) ,go.EASING_OUTBACK,0.2 )
		if self.focus_on_gun then
			local cur_dir_rad = math.rad(self.rot)
			local focus_dir = vmath.vector3(
			math.cos(cur_dir_rad),
			math.sin(cur_dir_rad),
			0) 
			msg.post("camera#camera_script","gun_focus",{focus = true , dir =  focus_dir, sound_manager = go.get_id("Sound_manager") })
		end
		if self.gun_state[self.rot] ~= nil then 
			sprite.set_vflip(self.gun_state[self.rot].slot, self.gun_state[self.rot].flip)
			self.cur_z = self.gun_state[self.rot].z_order
		end
		self.input_polls.right = false
		self.input_polls.left = false
	end

	--print(self.csp)
	
	local my_pos = go.get_position(".")
	local pl_pos =  go.get_position("Pl_Sprite")
	
	local x_y = vmath.vector3(pl_pos.x,pl_pos.y,self.cur_z)

	local new_pos = vmath.lerp(0.4,my_pos,x_y)	
	
	go.set_position(new_pos, ".")
	self.cur_pos = pl_pos
	
	-- if self.clipping_flag then
	-- 	self.clipped = true 
	-- 	--print("clipping flag ")
	-- else
	-- 	self.clipped = false
	-- end
	
	self.clipped  = self.clipping_flag 
	self.clipping_flag = false  
 
			
end
end


--go.set("go#cross_hair", "cros_pos", mouse_cords)
cros_pos.cros_poss = mouse_cords
--go.set("cross_hair", "euler.z", go.get("cross_hair", "euler.z") + 0.5 )
end
local function late_update(self)
	print("THIS SHIT IS FUKING ")
	if self.clipping_flag then
		print("clipping flag ")
		self.clipped = true 
	else
		self.clipped = false
	end
end

local gun_relapse = false

local function Gun_reload(self) 
	local reload_speed =  self.gun_master_list[self.gun_swap[self.cur_gun]].reload_speed / ( 1 + upgrades.data_layer["+reload speed"].speed * 2 )
	
	
	if self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag <= math.floor(self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size/3 ) then
		
		local In_mag_negative =  self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size - self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
		if self.cur_gun == 1 or self.second_gun_mags >= 1 then 
			--print("RELOAD TRIGGERED ")
			local s_s_max = 1.6
			local s_s_min = 1.1
			local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
			local bullets_to_give = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag + In_mag_negative
			local to_give_to = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag 
			local to_take_mags_from = self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
			self.reload_timer = true
			
		-- if self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags <= self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size then
		-- 	self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag =  self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag + self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size
		-- else
		-- 	self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag + (self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size - self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag)
		-- endll
		go.animate(".","euler.z",go.PLAYBACK_ONCE_FORWARD,go.get(".","euler.z")-360,go.EASING_OUTEXPO,reload_speed, 0.1, function()  
				go.set(go.get_id(),"euler.z", self.rot) 
				self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag = 0
				self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag + math.floor(  self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size  * ( 1 + (upgrades.data_layer["+mag size"].size ) )+0.1 )  
				--print("gun + stats = ",math.floor(  (self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag + In_mag_negative) * 1 + (upgrades.data_layer["+mag size"].size * 2 ) )   )
				--to_give_to = to_give_to + bullets_to_give
				if self.cur_gun ~= 1 then 
					self.second_gun_mags  =  self.second_gun_mags -  1
				--	to_take_mags_from = to_take_mags_from - 1 
				end
				display_gun(self)
				
				sound.stop("/Sound_manager#gun_reload")
				sound.play("/Sound_manager#gun_reload",{speed = random_offset, gain = 0.5})
				go.set("bullet_casing","position",go.get_world_position("target_trig"))
				particlefx.play("bullet_casing#mag_particle")
				self.reload_timer = false
			end)
		end
	end
	--print(go.get(go.get_id(),"euler.z"))
	gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
	gun_state.gun_max_mag  =  mag_display_switch(self) --self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
	
end

local function Gun_shoot(self)
	if gun_relapse  ~= true then
		local s_s_max = 1.1
		local s_s_min = 0.9
		local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
		sound.stop("gun_cont#shoot_sound_effect")
		go.set("bullet_casing","position",go.get_world_position("target_trig"))
		particlefx.play("bullet_casing#flying_shell")
		sound.play("gun_cont#shoot_sound_effect",{speed = random_offset, gain = 0.5})
		--print(random_offset)
		self.can_shoot = false
		self.gun_relapse = true
--		msg.post("/global#Timer_squeduler","add_timer",{data = {script = go.get_id(), type = "gun_relapse" , time = self.gun_master_list[self.gun_swap[self.cur_gun]].delay
--		, optional = 0 }})
		
		--timer.delay( self.gun_master_list[self.gun_swap[self.cur_gun]].delay ,false,
		--function() 
		--	gun_relapse = false
		--end)

		local opo_deg = (self.rot + 180) % 360
		local opo_rot_rad = math.rad(opo_deg)
		local direction = vmath.vector3(
		math.cos(opo_rot_rad ),
		math.sin(opo_rot_rad),
		0
		)
	local cur_pos = self.cur_pos
	cur_pos.z = self.cur_z
	direction = cur_pos + direction * self.gun_master_list[self.gun_swap[self.cur_gun]].recoil
	go.animate(".","position", go.PLAYBACK_ONCE_FORWARD, direction,go.EASING_OUTBACK , (0.01) ,0,
	function() 
--		msg.post("/global#Timer_squeduler","add_timer",{data = {script = go.get_id(), type = "can_shoot" , time = self.gun_master_list[self.gun_swap[self.cur_gun]].delay
		--, optional = 0 }})
		-- timer.delay(self.gun_master_list[self.gun_swap[self.cur_gun]].delay ,false,
		-- function()
		-- 	self.can_shoot = true
		-- end) 	
	end)
	
	for i = 1 , self.gun_master_list[self.gun_swap[self.cur_gun]].ammount do
		particlefx.stop("gun_cont#Gun_kickback_trtc")
		particlefx.play("gun_cont#Gun_kickback_trtc")
		local bullet_dir = self.rot
		if math.random(0,10) > 5 then
			bullet_dir = bullet_dir + math.random(0,self.gun_master_list[self.gun_swap[self.cur_gun]].spread) 
		else
			bullet_dir = bullet_dir - math.random(0,self.gun_master_list[self.gun_swap[self.cur_gun]].spread) 
		end
	
		local cur_dir_rad = math.rad(bullet_dir)
		local dir = vmath.vector3(
			math.cos(cur_dir_rad),
			math.sin(cur_dir_rad),
		self.cur_z) 
	
		local bullet_objct =  factory.create("gun_cont#bullet_spawner",go.get_world_position("target_trig"))
		msg.post(bullet_objct,"spawn_data",{ spawn_dir = dir, speed = self.gun_master_list[self.gun_swap[self.cur_gun]].bul_speed, dmg = self.gun_master_list[self.gun_swap[self.cur_gun]].dmg})
	end
	end
	
end

local function gun_focus(self) 
	if not self.focus_on_gun  then
		self.focus_on_gun = true 
		local cur_dir_rad = math.rad(self.rot)
		local focus_dir = vmath.vector3(
		math.cos(cur_dir_rad),
		math.sin(cur_dir_rad),
		0) 
		msg.post("camera#camera_script","gun_focus",{focus = true , dir =  focus_dir })
	else 
		self.focus_on_gun = false
		msg.post("camera#camera_script","gun_focus",{focus = false , dir =  vmath.vector3() })
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("collision_response" ) or hash("contact_point_response") then
		self.clipping_flag = true
--		print(self.clipping_flag)
			--self.clipped_items[#self.clipped_items] = sender
			--self.clipped = true
			--print("CLIPPING",self.clipped)
    end
	if message_id == hash("clipped") then
		if self.clipped == true then
			self.clipped_items[#self.clipped_items] = nil
			self.clipped = false
		end
	end
	if message_id == hash("timer_end") then 
		if message.type == "gun_relapse" then
			self.gun_relapse = false
		end
		if message.type == "can_shoot" then
			self.can_shoot = true
		end
	end
	if message_id == hash("trigger_response") then
		--print("TRIGGER TRIGGERREED ")
		if message.enter then
			--self.clipped_items[#self.clipped_items] = sender 
			 self.clipped = true 
		else
			--self.clipped_items[#self.clipped_items] =  nil
			self.clipped = false
			--pprint(self.clipped_items)

		end
	end
	if message_id == hash("mag_pickup") then 
		self.second_gun_mags = self.second_gun_mags + ( 1 +  upgrades.data_layer["+mags"].mags )
		gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag 
		gun_state.gun_max_mag  =  mag_display_switch(self) --self.second_gun_mags
		-- self.gun_master_list[self.gun_swap[self.cur_gun]].max_mag_size
	end
end
function on_input(self, action_id, action)
	if not game_state.paused then 
	if  self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag > 0 and Pstate.alive and not self.clipped and not self.reload_timer then
	if action_id == hash("trigger") then 
		if self.cur_gun == 1 then
			if not self.gun_1_delay then
				Gun_shoot(self)
				self.gun_1_delay = true 
				self.gun_1_timer = self.gun_master_list[self.gun_swap[self.cur_gun]].delay
				self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag - 1
				gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
			gun_state.gun_max_mag  =  mag_display_switch(self)--self.second_gun_mags --self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
			end

		end
		if self.cur_gun == 2 then
			if not self.gun_2_delay then
				self.gun_2_delay = true 
				Gun_shoot(self)
				self.gun_2_timer = self.gun_master_list[self.gun_swap[self.cur_gun]].delay
				self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag - 1
				gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
			gun_state.gun_max_mag  =  mag_display_switch(self)--self.second_gun_mags --self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
			end

		end
		
	end
	end
	if action_id == hash("swap") then
	if not self.reload_timer then  
		if self.btn_prst ~= true then
			self.btn_prst = true

			timer.delay( gun_rel_delay ,false,
			function() 
				self.btn_prst = false
			end)
			self.cur_gun = self.cur_gun + 1 
			if self.cur_gun > self.max_gun then 
				self.cur_gun = 1 
			end
			sprite.play_flipbook("gun_cont#slot", self.gun_master_list[ self.gun_swap[self.cur_gun] ].gun_name )
			gun_state.gun_name = self.gun_master_list[ self.gun_swap[self.cur_gun] ].gun_name
			gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
			gun_state.gun_max_mag  =  mag_display_switch(self)--self.second_gun_mags--self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
		end
		end
	end
	if action_id == hash("reload") then 
		if self.btn_prst ~= true then
			self.btn_prst = true
			
			timer.delay( 0.1 ,false,function() 
				self.btn_prst = false
			end)
			if not self.reload_timer then
				Gun_reload(self)
			end
		end
	end
	if action_id == hash("focus") then 
		if self.btn_prst ~= true then
			self.btn_prst = true

			timer.delay( gun_rot_delay ,false,
			function() 
				self.btn_prst = false
			end)
			gun_focus(self) 
		end
	end
	
	if action_id == hash("R_up")  then 
		self.gun_dir.y = action.value
	end
	if action_id == hash("R_down")  then 
		self.gun_dir.y = -action.value
	end
	if action_id == hash("R_left")   then 
		self.gun_dir.x = -action.value
	end
	if action_id == hash("R_right")  then 
		self.gun_dir.x = action.value
	end
	
	
	if action_id == hash("g_right") then 
		if self.btn_prst ~= true then
			self.btn_prst = true

			timer.delay( gun_rot_delay ,false,
			function() 
				self.btn_prst = false
			 end)
			self.input_polls.right = true 
		end
	end
	if action_id == hash("g_left") then 
		if self.btn_prst ~= true then
			self.btn_prst = true

			timer.delay(gun_rot_delay ,false,
			function() 
				self.btn_prst = false
			end)
			self.input_polls.left = true 
		end
	end
end
if action.x ~= nil and action.y ~= nil then
	local w,h =  window.get_size()
	self.gun_dir.x =  action.screen_x - (w/2) 
	self.gun_dir.y =  action.screen_y  - (h/2) 

	mouse_cords = vmath.vector3(action.x,action.y ,0)
	--print("THIS RAN THE GUN COMPONENT ",self.gun_dir.x,self.gun_dir.y)
end
end
function on_reload(self)
end
