	gun_state.gun_cur_in_mag = self.gun_master_list[self.gun_swap[self.cur_gun]].in_mag
	gun_state.gun_max_mag  =  "INF"--self.gun_master_list[self.gun_swap[self.cur_gun]].total_mags
