		["awp"] = {spread = 1, bul_speed = 260, delay = 1, ammount = 1, recoil = 10,dmg = 20, reload_speed = 1 , max_mag_size = 1, in_mag = 1, total_mags = self.defualt_cheat_vl },
		["ak47"] = {spread = 15, bul_speed = 210, delay = 0.15, ammount = 1, recoil = 2,dmg = 1.5, reload_speed = 1 ,max_mag_size = 35, in_mag = 35, total_mags = self.defualt_cheat_vl },
		["shotgun"] = {spread = 20, bul_speed = 200, delay = 2, ammount = 10, recoil = 7,dmg = 1,reload_speed = 2  ,   max_mag_size = 5, in_mag = 5, total_mags = self.defualt_cheat_vl },
		["mp5"] = {spread = 10, bul_speed = 210, delay = 0.2, ammount = 2, recoil = 1,dmg = 1.5,reload_speed = 0.7 ,   max_mag_size = 25, in_mag = 25, total_mags = self.defualt_cheat_vl }, 
		--["arrow"] = {spread = 0, bul_speed = 0, delay = 0.1, ammount = 0, recoil = 0},
		["m4"] = {spread = 0, bul_speed = 210, delay = 0.3, ammount = 1, recoil = 1.5,dmg = 3 , reload_speed = 0.7, max_mag_size = 30, in_mag = 30, total_mags = self.defualt_cheat_vl }, 
		["revolver"] = {spread = 3, bul_speed = 250, delay = 0.1, ammount = 1, recoil = 4,dmg = 4, reload_speed = 3 ,  max_mag_size = 6, in_mag = 6, total_mags = self.defualt_cheat_vl }, 
		["p90"] = {spread = 2, bul_speed = 230, delay = 0.05, ammount = 1, recoil = 1,dmg = 0.5,reload_speed = 0.5 , max_mag_size = 50, in_mag = 50, total_mags = self.defualt_cheat_vl },
	}
	
	self.gun_state = {
		--[0] = {flip = false, z_order = 1.19, slot = "gun_cont#slot" },
		[-45] = {flip = false, z_order = 1.21, slot = "gun_cont#slot" },
		[-90] = {flip = false, z_order = 1.21, slot = "gun_cont#slot" },
		[-135] = {flip = true, z_order = 1.21, slot = "gun_cont#slot" },
		[-180] = {flip = true, z_order = 1.19, slot = "gun_cont#slot" },
		[-225] = {flip = true, z_order = 1.19, slot = "gun_cont#slot" },
		[-270] = {flip = true, z_order = 1.19, slot = "gun_cont#slot" },
		[-315] = {flip = false, z_order = 1.19, slot = "gun_cont#slot" },
		[-360] = {flip = false, z_order = 1.19, slot = "gun_cont#slot" },

		
		[45] = {flip = false, z_order = 1.19, slot = "gun_cont#slot" },
		[90] = {flip = false, z_order = 1.19, slot = "gun_cont#slot" },
		[135] = {flip = true, z_order = 1.19, slot = "gun_cont#slot" },
		[180] = {flip = true, z_order = 1.19, slot = "gun_cont#slot" },
		[225] = {flip = true, z_order = 1.21, slot = "gun_cont#slot" },
		[270] = {flip = true, z_order = 1.21, slot = "gun_cont#slot" },
		[315] = {flip = false, z_order = 1.21, slot = "gun_cont#slot" },
