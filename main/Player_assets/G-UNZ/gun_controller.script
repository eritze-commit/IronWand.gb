	self.csp =  go.get("gun_cont#slot","position")
	--self.gun_swap = {"god","pistol","uzi","awp","ak47","shotgun","mp5","m4","revolver","p90"}
--	self.gun_swap = {"god","2gun"}
	self.gun_swap = {"pistol","2gun"}
	self.recoil_offset = vmath.vector3(0,0,0)
	self.cur_gun = 1
