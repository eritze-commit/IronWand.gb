end

function on_input(self, action_id, action)
	--got_input(self,action_id)
	--print("ACTION "..action_id)
	if action_id == hash("right") then
		if action.pressed then
			self.input.right = true
			msg.post("Pl_Sprite#Pl_Sprite_Script","right_dir_change",{dir = true })
		elseif action.released then
			self.input.right = false
			msg.post("Pl_Sprite#Pl_Sprite_Script","right_dir_change",{dir = false })
		end
	end
	if  action_id == hash("left") then 
		if action.pressed then
			self.input.left = true
			msg.post("Pl_Sprite#Pl_Sprite_Script","left_dir_change",{dir = true })
		elseif action.released then
			self.input.left = false
			msg.post("Pl_Sprite#Pl_Sprite_Script","left_dir_change",{dir = false })
		end
	end
	if  action_id == hash("down") then 
		if action.pressed then
			self.input.bottom = true
			msg.post("Pl_Sprite#Pl_Sprite_Script","down_dir_change",{dir = true })
		elseif action.released then
			self.input.bottom = false
			msg.post("Pl_Sprite#Pl_Sprite_Script","down_dir_change",{dir = false })
		end
	end
	if action_id == hash("up") then 
		if action.pressed then
			msg.post("Pl_Sprite#Pl_Sprite_Script","up_dir_change",{dir = true })
			self.input.up = true
		elseif action.released then
			msg.post("Pl_Sprite#Pl_Sprite_Script","up_dir_change",{dir = false })
			self.input.up = false
		end
	end
	if action_id == hash("dash") then 
		--print("preseed the x button ")
		dash(self)
	end
	--print("input"..self.input.right..self.input.left..self.input.bottom..self.input.up)

end