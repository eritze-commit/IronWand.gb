local Pstate = require "main.Player_assets.Player_state_module"
local dash_timer = 0.1
local can_dash = true 
local dash_cooldown = 2
local dash_state = false  
local dash_init = false 
local last_position = vmath.vector3()
local dash_dir = vmath.vector3()
local dash_speed = 300

function init(self)
	msg.post(".", "acquire_input_focus")
	self.speed = 80
	self.horizontal = "Left"
	self.new_pos = vmath.vector3(0, 0, 0)
	self.running = ""
	self.pos = go.get_position(".")
	self.last_pos  = vmath.vector3(0, 0, 0)
	self.state = ""
	self.prev_state = ""
	self.dir = vmath.vector3(0, 0, 0)
	self.correction = vmath.vector3()
	self.input={left= false, right = false ,up = false, down = false ,roll = false}
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function final(self)
	--sprite.play_flipbook(".", hash(string.format(self.running.."_"..self.vertical.."_"..self.horizontal)))
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

local function input_direction(self) 
	self.dir = vmath.vector3(0,0,0) 
	if self.input.right then 
		--physics.apply_force()
		self.dir.x = self.dir.x + 1 
		self.prev_state = "right"
		self.horizontal = "Right"
	end
	if self.input.left then 

		self.dir.x = self.dir.x - 1 
		self.prev_state = "left"
		self.horizontal = "Left"
	end
	if self.input.up then 
		self.dir.y = self.dir.y + 1 
		self.prev_state = "up"
	end
	if self.input.bottom then 
		self.dir.y = self.dir.y - 1 
		self.prev_state = "down"
	end

end
local function dash(self) 
	--sound.stop("sounds#Dash")
	if dash_state == false and can_dash  then 
		if vmath.length_sqr(self.dir) > 0  then
			local s_s_max = 6
			local s_s_min = 3
			local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
			sound.stop("sounds#Dash")
			sound.play("sounds#Dash",{speed = random_offset ,gain=1})
		end
		msg.post("Pl_Sprite#Pl_Sprite_Script","dash",{dash = true})
		Pstate.dashing = true
		dash_state = true 
		can_dash = false
		dash_init = true 
		last_position = go.get_position(".")
		msg.post("dsh_trg#dash_trigger","dsh_trg",{dashing = true, lst_pos = last_position, time = dash_timer})
		if vmath.length_sqr(self.dir) > 0  then
			dash_dir = vmath.normalize(self.dir)
		else
			dash_dir = self.dir
		end 
		msg.post("camera#camera_script","camera_snap",{dashing = true, dir = dash_dir })
		local angle = math.atan2(dash_dir.y,dash_dir.x)
		if vmath.length_sqr(dash_dir) > 0  then
			go.set_rotation(vmath.quat_rotation_z(angle),"Particle #Plr_Dash" )
		--	msg.post("dsh_trg#dash_trigger","dsh_trg",{dashing = false, lst_pos = last_position})
			msg.post("camera#camera_script","camera_snap",{dashing = false , dir = dash_dir })
			particlefx.play("Particle #Plr_Dash")
			--particlefx.play("Particle #PLr_Trail")
		end
		
		timer.delay(dash_timer, false, function()
			Pstate.dashing = false
			dash_state = false 
			msg.post("Pl_Sprite#Pl_Sprite_Script","dash_end",{dash = false,  cng_spr = "walking" })
			particlefx.stop("Particle #Plr_Dash")
			--particlefx.stop("Particle #PLr_Trail")
			dash_init = false 
			timer.delay(dash_cooldown, false, function()
				
				--particlefx.stop("Particle #PLr_Trail")
				--particlefx.stop("Particle #PLr_Trail")
				can_dash = true 
			end)
		end
		
		)
		
	end
end
function update(self, dt)
	input_direction(self) 
	--print("self.dir :"..self.dir)
	Pstate.player_dir = self.dir
	Pstate.player_speed = self.speed
	if vmath.length_sqr(self.dir) > 0 and  dash_state == false  then 
		self.pos = go.get_position(".")
		--local velocity = go.get("#collisionobject", "linear_velocity")
		
		--local linear_velocity = vmath.vector3(velocity.x + self.dir.x * self.speed,velocity.y + self.dir.y * self.speed,1.05)
		
		--go.set("#collisionobject","linear_velocity",linear_velocity)
		--go.set_position(go.get("position"), "#collisionobject")
		
		-- math.floor(player.y / grid_size) * grid_size
		self.new_pos = self.pos + vmath.normalize(self.dir) * self.speed * dt
		--self.new_pos = vmath.vector3(math.floor(self.new_pos.x ), math.floor(self.new_pos.y), 1.05 )
		go.set_position(self.new_pos, ".") 
		--local cur_pos = go.get_position(".")
		--local new_pos = vmath.vector3(math.floor(cur_pos.x),math.floor(cur_pos.y),cur_pos.z)
		--go.set_position(new_pos , ".")
		--print(go.get_position("."))
	end

	--self.cur_anim = hash(self.running.."_"..self.horizontal)
	--if self.state ~= self.prev_state  then
	--	sprite.play_flipbook("#sprite",self.cur_anim)
	--	self.state = self.prev_state
	--end
	--print("player pos "..self.pos)
	-- self.prev_state = ""
	--msg.post(self.camera,hash("FLW"),{ value = true })
	if dash_init then
		self.pos = go.get_position(".")
		self.pos = self.pos + dash_dir * dash_speed * dt
		go.set_position(self.pos, ".")
		Pstate.player_dir = dash_dir
		Pstate.player_speed = dash_speed * dt
	end
end

