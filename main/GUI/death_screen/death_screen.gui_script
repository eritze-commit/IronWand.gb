local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
local global = require("main.GLOBAL.GLOBAL")
function init(self)
    self.game_over_nodes = {"game_over","box"}
    self.death_screen_nodes = {"down_1_image","down_2_image","down_3_image","down_4_image","down_5_image","down_6_image","backdrop","floor","menu","restart","difficulty","time","upgrade_text"}
    self.all_nodes = {"game_over","box","down_1_image","down_2_image","down_3_image","down_4_image","down_5_image","down_6_image","backdrop","floor","menu","restart","difficulty","time","upgrade_text"}
    self.all_death_screen_node_positions = {
    ["down_1_image"] = vmath.vector3(108,202,0),
    ["down_2_image"] = vmath.vector3(188,202,0),
    ["down_3_image"] = vmath.vector3(268,202,0),
    ["down_4_image"] = vmath.vector3(348,202,0),
    ["down_5_image"] = vmath.vector3(428,202,0),
    ["down_6_image"] = vmath.vector3(508,202,0),
    ["backdrop"] = vmath.vector3(270,255,0),
    ["floor"] = vmath.vector3(308,430,0),
    ["menu"] = vmath.vector3(305,90,0),
    ["restart"] = vmath.vector3(305,135,0),
    ["difficulty"] = vmath.vector3(308,400,0),
    ["time"] = vmath.vector3(308,370,0),
    ["upgrade_text"] = vmath.vector3(308.0,273.0,0),
    ["selector"] = vmath.vector3(108,202,0),
    }
    for i= 1 , #self.all_nodes do 
        gui.set_enabled(gui.get_node(self.all_nodes[i]),false )
    end
    self.button_selected = false
    self.last_node_selected = "menu"
    self.cur_button_state = 1
    self.button_default_color = vmath.vector4(0.8, 0.8, 0.8, 1)
	self.node_highlight_color = vmath.vector4(1, 1, 1, 1)
	self.button_states = {"restart","menu"}
	self.upgrade_view = false
	self.cur_upgrade_state = 1
	self.button_actions = {
	["restart"] = function()
        
        msg.post("/Gui_collection/death#death_screen","release_input_focus")

        for i= 1 , #self.all_nodes do 
            gui.set_enabled(gui.get_node(self.all_nodes[i]),false )
        end


        msg.post("/global#Game_state_manager","change_state",{state = "playing"})
  end,
        
	["menu"] = function() 
         msg.post("/Gui_collection/death#death_screen","release_input_focus")

        for i= 1 , #self.all_nodes do 
            gui.set_enabled(gui.get_node(self.all_nodes[i]),false )
        end

        msg.post("/global#Game_state_manager","change_state",{state = "menu"})
	end,
	}
	-- self.cur_button_state = 1 
 --    gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.node_highlight_color) 
    
    
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

