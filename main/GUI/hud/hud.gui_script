local Pstate = require("main.Player_assets.Player_state_module")
local active = require("main.Enemy_Assets.drops.spawnded_items_data")
local gun_state = require("main.Player_assets.G-UNZ.Hud_state")
local dtime = require("main.Shader_adjecent_files.Post_processing.dtime")
local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
local global = require("main.GLOBAL.in_game")
local game_state = require("main.GLOBAL.GLOBAL")

local all_nodes = {"Gun_ammo","enemy_count","map_info","box",
"heatlh_bar","health_bar_back_drop","combo","mana",
"mana_icon","pause_box","paused","health","health_box","upgrade_text","selector","menu","settings","restart","back"}

local function menu_sfx(sfx)
	local s_s_max = 1.05
	local s_s_min = 0.95
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	sound.play("/Sound_manager#"..sfx,{speed = random_offset })
end

local  Last_in_mag = 0 
local scale_strenght = 0.05

local last_enemy = 0
local last_name = ""
local last_mag = 0 

local last_mana = 0

local floor_state = ""
local table_floor_state = { 
	["not_visible"] = vmath.vector3(314.0,-52.0,0),
	["visible"] = vmath.vector3(314.0,239.0,0)
							}


local visible = false

							
function init(self)
	self.button_selected = false
    self.last_node_selected = "menu"
    self.cur_button_state = 0
    self.button_default_color = vmath.vector4(0.8, 0.8, 0.8, 1)
	self.node_highlight_color = vmath.vector4(1, 1, 1, 1)
	self.button_states = {"back","settings","menu","restart"}
	self.upgrade_view = false
	self.cur_upgrade_state = 1
	self.button_actions = { 
		["restart"] = function()
        
		Pstate.alive = false
		active.cur_scene_active = false 
		msg.post("/global#Game_state_manager","change_state",{state = "paused",extra = false})
		global.paused = false
		visible = false
        msg.post("/global#Game_state_manager","change_state",{state = "playing"})
  end,
		["back"] = function()
        
		
		
		global.paused = false
		msg.post("/global#Game_state_manager","change_state",{state = "paused",extra = false})
		visible = false
        --msg.post("/global#Game_state_manager","change_state",{state = "playing"})
  end,
	["settings"] = function() 
		msg.post(".","release_input_focus")
		msg.post(".","show_gui",{show = false})
		msg.post("/Gui_collection/settings#settings_menu","toggle_true")
	end,
        

        
	["menu"] = function() 
	
		Pstate.alive = false
		active.cur_scene_active = false 
		msg.post("/global#Game_state_manager","change_state",{state = "paused",extra = false})
		global.paused = false
		visible = false
        for i= 1 , #all_nodes do 
            gui.set_enabled(gui.get_node(all_nodes[i]),false )
        end

		msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","clear_enemies",{clea = true})
        msg.post("/global#Game_state_manager","change_state",{state = "menu"})
	end,
	
	}
	--msg.post(".", "acquire_input_focus")
	self.time = 0
	self.health_bar_size = gui.get(gui.get_node("heatlh_bar" ),"scale.x")
	self.combo_normal_euler = gui.get(gui.get_node("combo"),"euler.z")

	for i = 1 , #all_nodes do 
		gui.set_enabled(gui.get_node(all_nodes[i]),false)
	end
	
end

local function Show_all(show)
	for i = 1 , #all_nodes do 
		gui.set_enabled(gui.get_node(all_nodes[i]),show)
	end
end


function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed  		
end

function update(self, dt)
	
	self.time = self.time * dt
	dtime.dt = self.time 
	
	if gun_state.gun_cur_in_mag ~= Last_in_mag or gun_state.gun_name ~= last_name or gun_state.gun_max_mag ~= last_mag  then 
		Last_in_mag = gun_state.gun_cur_in_mag
		last_name = gun_state.gun_name
		last_mag = gun_state.gun_max_mag
		gui.set_text( gui.get_node("Gun_ammo" ),gun_state.gun_name.."\n"..gun_state.gun_cur_in_mag.."/"..gun_state.gun_max_mag)
		gui.animate( gui.get_node("Gun_ammo" ), "scale",vmath.vector3(1+scale_strenght,1+scale_strenght,1),go.EASING_INBOUNCE,0.05,0, function() 
			gui.animate( gui.get_node("Gun_ammo" ), "scale",vmath.vector3(1,1,1),go.EASING_INBOUNCE,0.05,0)
		end)
		--gui.animate
	end
	if gun_state.enemy_cur_alive ~= last_enemy then
		last_enemy = gun_state.enemy_cur_alive
		gui.set_text( gui.get_node("enemy_count" ),"Wave :"..gun_state.enemy_cur_wave.."\n"..gun_state.enemy_cur_alive.."/"..gun_state.enemy_max_in_lvl)
		gui.animate( gui.get_node("enemy_count" ), "scale",vmath.vector3(1+scale_strenght,1+scale_strenght,1),go.EASING_INBOUNCE,0.05,0, function() 
			gui.animate( gui.get_node("enemy_count" ), "scale",vmath.vector3(1,1,1),go.EASING_INBOUNCE,0.05,0)
		end)
	end
	if gun_state.mana ~= last_mana then
		last_mana = gun_state.mana
		gui.set_text( gui.get_node("mana")," :"..gun_state.mana)
		gui.animate( gui.get_node("mana"), "scale",vmath.vector3(1+scale_strenght,1+scale_strenght,1),go.EASING_INBOUNCE,0.05,0, function() 
			gui.animate( gui.get_node("mana"), "scale",vmath.vector3(1,1,1),go.EASING_INBOUNCE,0.05,0)
		end)
	end
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

local function icon_display(table) 
	if  table.name ~= "2gun" and table.name ~= "1gun" then
			return table.name 
	else
			return table.type
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("update_pause_values") then
		gui.set_text(gui.get_node("floor"),"floor: "..gun_state.map_cur_floor)
		for i = 1 , 6 do
			gui.set_visible(gui.get_node("down_"..i.."_image"), visible )
			local temp_image_name = icon_display(upgrades.upgrade_slots[i])
			if temp_image_name ~= nil then
				gui.play_flipbook(gui.get_node("down_"..i.."_image"), temp_image_name)
			else
				gui.play_flipbook(gui.get_node("down_"..i.."_image"), "empty")
			end
		end
	end
	if message_id == hash("cancel_up_floor") then
		gui.cancel_animations(gui.get_node("box"),"position")
		gui.cancel_animations(gui.get_node("map_info"),"position")
		gui.set_position(gui.get_node("box"),vmath.vector3(-609.0,240.0,0))
		gui.set_position(gui.get_node("map_info"),vmath.vector3(337.0,-52.0,0))
	end
	if message_id == hash("settings_back") then
		timer.delay(0.2,false, function() 
			msg.post(".","acquire_input_focus")
		end)
		msg.post(".","show_gui",{show = true})
		
	end
	if message_id == hash("paused") then
		print("TS ran ")
		local visible = message.visibles
		gui.set_visible(gui.get_node("pause_box"), visible)
		gui.set_visible(gui.get_node("paused"), visible )
		gui.set_visible(gui.get_node("floor"),visible)
		gui.set_visible(gui.get_node("upgrade_text"),visible)
		gui.set_visible(gui.get_node("selector"),visible)
		gui.set_visible(gui.get_node("menu"),visible)
		gui.set_visible(gui.get_node("settings"),visible)
		gui.set_visible(gui.get_node("restart"),visible)
		gui.set_visible(gui.get_node("back"),visible)
		gui.set_text(gui.get_node("restart"),"restart [ diff "..game_state.cur_diff.." ]")
		if self.upgrade_view then
			if upgrades.upgrade_slots[self.cur_upgrade_state].description ~= nil then
				gui.set_text(gui.get_node("upgrade_text"),upgrades.upgrade_slots[self.cur_upgrade_state].description)
			else
				gui.set_text(gui.get_node("upgrade_text"),"empty")
			end
		end
		gui.set_text(gui.get_node("floor"),"floor: "..gun_state.map_cur_floor)
		for i = 1 , 6 do
			gui.set_visible(gui.get_node("down_"..i.."_image"), visible )
			local temp_image_name = icon_display(upgrades.upgrade_slots[i])
			if temp_image_name ~= nil then
				gui.play_flipbook(gui.get_node("down_"..i.."_image"), temp_image_name)
			else
				gui.play_flipbook(gui.get_node("down_"..i.."_image"), "empty")
			end
		end
		
	end
	if message_id == hash("health_bar_skin") then
--		print("TS RAN MF ")
		if message.health_bar == "bar_slide_2" then
			gui.set_color(gui.get_node("health"), vmath.vector4(1,0,1,1))
		else
			gui.set_color(gui.get_node("health"), vmath.vector4(1,1,1,1))
		end
		gui.play_flipbook(gui.get_node("heatlh_bar"), message.health_bar)
	end
	if message_id == hash("show_gui") then 
		Show_all(message.show)
	end
	if message_id == hash("map_info") then 
		--print("GOT iT THE GUI GOT THE THING ")
		--gui.set( gui.get_node("box" ),"visible",true)
		--gui.set(gui.get_node("map_info" ),"visible",true)
		gui.set_position(gui.get_node("box"),vmath.vector3(-609.0,240.0,0))
		gui.set_position(gui.get_node("map_info"),vmath.vector3(337.0,-52.0,0))
		
		gui.animate( gui.get_node("box" ), "position",vmath.vector3(319.0,240.0,0),go.EASING_INEXPO,1,0, function() 
			gui.animate( gui.get_node("box" ), "position",vmath.vector3(-654.0,240.0,0),go.EASING_OUTEXPO,1,1.5)
			--gui.set( gui.get_node("box" ),"visible",false)
		end)
		gui.set_text( gui.get_node("map_info" ),"Floor :"..gun_state.map_cur_floor)
		gui.animate( gui.get_node("map_info" ), "position",table_floor_state["visible"],go.EASING_INEXPO,2,0, function() 
			gui.animate( gui.get_node("map_info" ), "position",table_floor_state["not_visible"],go.EASING_OUTEXPO,0.5,0.5)
			--gui.set(gui.get_node("map_info" ),"visible",false)
		end)
	end
	if message_id == hash("health_bar_change") then 
		local health_bar_factor = message.health / message.max_health
		gui.set_text(gui.get_node("health") ,(math.floor(message.health*10+0.5))/10 .."/"..message.max_health )
		gui.animate(gui.get_node("heatlh_bar" ),"scale.x",self.health_bar_size*health_bar_factor,go.EASING_INEXPO,0.1)
	end
	if message_id == hash("update_combo") then 
		gui.set_visible(gui.get_node("combo"), message.visible)
		gui.set(gui.get_node("combo"),"color",message.color)
		gui.set_text(gui.get_node("combo"),"x"..message.combo)

		gui.animate( gui.get_node("combo" ), "scale",vmath.vector3(1+message.strenght,1+message.strenght,1),go.EASING_INBOUNCE,0.1,0, function() 
			gui.animate( gui.get_node("combo" ), "scale",vmath.vector3(1,1,1),go.EASING_INBOUNCE,0.1,0)
		end)
		local random_offset = math.random(0,1) < 1 and 1 or -1 
		gui.animate( gui.get_node("combo" ), "euler.z",(self.combo_normal_euler + math.random(5+(message.strenght*3),10+(message.strenght*4)))*random_offset,go.EASING_INBOUNCE,0.1,0, function() 
			gui.animate( gui.get_node("combo" ), "euler.z",self.combo_normal_euler ,go.EASING_INBOUNCE,0.1,0)
		end)
		
	end
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

local pressed = false


function on_input(self, action_id, action)
	if not self.button_selected and global.paused then 
		if action_id == hash("action_but") and not self.button_selected then 
			if self.cur_button_state ~= 0 and not self.upgrade_view then
				self.button_selected = true
				timer.delay(0.2,false,function() 
					self.button_selected = false
				end)
			
				self.button_actions[self.button_states[self.cur_button_state]]()
				menu_sfx("menu_select")
			
			end
		end
		self.button_selected = true
			timer.delay(0.125,false,function() 
				self.button_selected = false
			end)
		if action_id == hash("right") or action_id == hash("left")  then
			if self.upgrade_view then
			
			
			if action_id == hash("right") then
				self.cur_upgrade_state = self.cur_upgrade_state + 1 
			else
				self.cur_upgrade_state = self.cur_upgrade_state - 1 
			end
			if self.cur_upgrade_state <= 0 then
				self.cur_upgrade_state = #upgrades.upgrade_slots
			elseif self.cur_upgrade_state > #upgrades.upgrade_slots then
				self.cur_upgrade_state = 1
			end
			gui.set_position(gui.get_node("selector"),gui.get_position(gui.get_node("down_"..self.cur_upgrade_state.."_image")))
			if upgrades.upgrade_slots[self.cur_upgrade_state].description ~= nil then
				gui.set_text(gui.get_node("upgrade_text"),upgrades.upgrade_slots[self.cur_upgrade_state].description)
			else
				gui.set_text(gui.get_node("upgrade_text"),"empty")
			end
			menu_sfx("menu_move")
			
			end
		end
		if action_id == hash("down") or action_id == hash("up") then 
			
			
			
		
		if action_id == hash("down") then
			
			self.cur_button_state = self.cur_button_state + 1 
			if self.upgrade_view then
				gui.set_text(gui.get_node("upgrade_text"),":")
				self.cur_button_state = 1 
				self.upgrade_view = false 
				gui.play_flipbook(gui.get_node("selector"),"nothing")
				gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.node_highlight_color)	
			end
			if self.cur_button_state > #self.button_states then
				self.cur_button_state = #self.button_states
				--print("TS ran ")
				if not self.upgrade_view then
					--print("TS ran 2")
					if upgrades.upgrade_slots[self.cur_upgrade_state].description ~= nil then
						gui.set_text(gui.get_node("upgrade_text"),upgrades.upgrade_slots[self.cur_upgrade_state].description)
					else
						gui.set_text(gui.get_node("upgrade_text"),"empty")
					end
					self.upgrade_view = true
					gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.button_default_color)
					gui.play_flipbook(gui.get_node("selector"),"selector")
				end
			end
			
		else
			
			self.cur_button_state = self.cur_button_state - 1 
			if self.upgrade_view then
					self.upgrade_view = false
					self.cur_button_state = #self.button_states
					gui.set_text(gui.get_node("upgrade_text"),":")
					gui.play_flipbook(gui.get_node("selector"),"nothing")
					gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.node_highlight_color)
			end
			if self.cur_button_state <= 0  then
				self.cur_button_state = 1 
				if not self.upgrade_view then
					if upgrades.upgrade_slots[self.cur_upgrade_state].description ~= nil then
						gui.set_text(gui.get_node("upgrade_text"),upgrades.upgrade_slots[self.cur_upgrade_state].description)
					else
						gui.set_text(gui.get_node("upgrade_text"),"empty")
					end
					self.upgrade_view = true 
					gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.button_default_color)
					gui.play_flipbook(gui.get_node("selector"),"selector")
				
				end
				--self.cur_button_state = #self.button_states
			end
		end
		--print("upgrade view",self.upgrade_view,"cur node ",self.cur_button_state  )
		if self.upgrade_view then
			menu_sfx("menu_move")
		else
			gui.set(gui.get_node(self.last_node_selected),"color",self.button_default_color)
			gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.node_highlight_color)
			self.last_node_selected = self.button_states[self.cur_button_state ]
			menu_sfx("menu_move")
		end
		
		
	end


	end
	

	if action_id == hash("escape") and not pressed then
		pressed = true
		timer.delay(0.2,false,function() 
			pressed = false
		end)
		--print("upgrade ran ")
		if visible then 
			visible = false
		else
			visible = true
		end
		msg.post("/global#Game_state_manager","change_state",{state = "paused", extra = visible })
	end
		
	
	-- Add input-handling code here. The game object this script is attached to
	-- must have acquired input focus:
	--
	--    msg.post(".", "acquire_input_focus")
	--
	-- All mapped input bindings will be received. Mouse and touch input will
	-- be received regardless of where on the screen it happened.
	-- Learn more: https://defold.com/manuals/input/
	-- Remove this function if not needed
end

