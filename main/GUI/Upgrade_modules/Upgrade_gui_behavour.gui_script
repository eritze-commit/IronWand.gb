function on_input(self, action_id, action)
	if not self.button_selected then 
		if action_id == hash("down") or action_id == hash("up") then 

			self.button_selected = true
			timer.delay(0.2,false,function() 
				self.button_selected = false
			end)
			if action_id == hash("down") then 
				cur_slot = cur_slot + 1

				if cur_slot > 3 then
					cur_slot =  1 
				end
			else
				cur_slot = cur_slot - 1
				if cur_slot <= 0  then
					cur_slot =  3 
				end
			end 
			
			
			gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_text"))-vmath.vector3(45,0,0), go.EASING_INEXPO, 0.2)
			--gui.animate(gui.get_node("Up_"..cur_slot.."_text"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_text")), go.EASING_INEXPO, 0.2)

			gui.set_text(gui.get_node("price"),"Price : "..upgrades.shop_slots[cur_slot].price)

			local s_s_max = 1.5
			local s_s_min = 0.5
			local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
			
			sound.play("/Sound_manager#select_sound",{speed = random_offset ,gain=1})
			
			-- if self.button_states[self.cur_button_state] ~= "none" then
			-- 	self.last_node_selected = self.button_states[self.button_state]
			-- 	gui.set(gui.get_node("start"),"color",self.node_highlight_color)
			-- 	--gui.set_color()
			-- else
			-- 	gui.set(gui.get_node("start"),"color",self.button_default_color)
			-- end

		end
		if action_id == hash("action_but") and not self.button_selected  then 
			if self.button_states[self.cur_button_state] ~= "none" then
				self.button_selected = true
				timer.delay(0.2,false,function() 
					self.button_selected = false
				end)
				msg.post("/global#Game_state_manager","change_state",{state = "playing"})
			end
		end
	end
end

