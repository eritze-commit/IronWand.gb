function update(self, dt)
	-- msg.post("@render:", "draw_debug_text", { text = "state_of_screen: " .. state_of_screen, position = vmath.vector3(50, 100, 0), color = vmath.vector4(1,1,1,1) })
	-- msg.post("@render:", "draw_debug_text", { text = "cur_slot: " .. cur_slot, position = vmath.vector3(225, 100, 0), color = vmath.vector4(1,1,1,1) })
	-- msg.post("@render:", "draw_debug_text", { text = "cur_slot_down: " .. cur_slot_down, position = vmath.vector3(325, 100, 0), color = vmath.vector4(1,1,1,1) })
	-- msg.post("@render:", "draw_debug_text", { text = "cur_slot_Up_right: " .. cur_slot_Up_right, position = vmath.vector3(460, 100, 0), color = vmath.vector4(1,1,1,1) })
