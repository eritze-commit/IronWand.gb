local function play_sfx(sfx,options)
	local s_s_max = 1.5
	local s_s_min = 0.5
	if options == nil then 
		 s_s_max = 1.5
		 s_s_min = 0.5
	else
		s_s_max = options[2 ]
		s_s_min = options[1]
	end
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))

	sound.play(sfx,{speed = random_offset ,gain=1})
end

local function reset_shop_button_price()
	local price =  math.random(0,1) +  math.floor((hud_state.map_cur_floor/ global.max_floor) * 20)
	reset_shop_price = reset_shop_price + price 
end



local function icon_display(table) 
	if table.name ~= "2gun" and table.name ~= "1gun"  then 
			return table.name 
	else
			return table.type
	end
end

local function render_bottom_row()
	for i = 1 , 6 do
		local temp_image_name = icon_display(upgrades.upgrade_slots[i]) 
		if temp_image_name ~= nil then
			gui.play_flipbook(gui.get_node("down_"..i.."_image"), temp_image_name)
		else
			gui.play_flipbook(gui.get_node("down_"..i.."_image"), "empty")
			
		end
	end
end 
local function quit_shop(self)
	msg.post(".", "release_input_focus")
	reset_shop_price = 0
	for i in ipairs(self.all_nodes) do 

		gui.set_enabled(gui.get_node(self.all_nodes[i]),false)
	end
	if enabled == false then 
		hud_state.map_cur_floor = hud_state.map_cur_floor - 1 
		msg.post("/global#Game_state_manager","change_state",{state = "up_floor"})
	end
	-- subtract one from the map floor because going to up floor is going to add one 

end

local function shake_selector(options)
	play_sfx("/Sound_manager#IR_shop_errir",{0.5,1})
		local starting_pos = vmath.vector3()
		if options == nil then
			starting_pos = gui.get_position(gui.get_node("down_"..cur_slot_down.."_image"))
		else
			starting_pos = gui.get_position(gui.get_node("Up_"..cur_slot.."_image"))
		end
		if options == "up_right" then 
			starting_pos = gui.get_position(gui.get_node("Up_"..cur_slot_Up_right.."_left"))
		end
		local negatizer_x = math.random(0,1) == 1 and 1 or -1
		local negatizer_y = math.random(0,1) == 1 and 1 or -1
		local strenght = 10
		gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("selector"))+vmath.vector3(math.random()*strenght*negatizer_x,math.random()*strenght*negatizer_y,0), gui.EASING_INEXPO, 0.01, 0, function() 
			negatizer_x = math.random(0,1) == 1 and 1 or -1
			negatizer_y = math.random(0,1) == 1 and 1 or -1
			strenght = 10
			gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("selector"))+vmath.vector3(math.random()*strenght*negatizer_x,math.random()*strenght*negatizer_y,0), gui.EASING_INEXPO, 0.01, 0, function() 
				gui.animate(gui.get_node("selector"), "position",starting_pos, gui.EASING_INEXPO, 0.05)
			end)				
		end)
end

local function change_state_position(self, position)
	lockdown = true
	play_sfx("/Sound_manager#IR_shop_swoosh",{0.95,1.05}) 
	local dir = position == "neg" and 1 or -1  
	if dir == 1 then 
		render_bottom_row()
	end
	for i = 1 , #self.all_nodes do 
		gui.animate(gui.get_node(self.all_nodes[i]), "position", gui.get_position(gui.get_node(self.all_nodes[i]))+vmath.vector3(0,500*dir,0) , gui.EASING_INEXPO, 0.3, 0, function() lockdown  = false  end)
	end
end


local function upgrade_compare(input) 
	for i = 1 , #upgrades.upgrade_slots do 
		if input == upgrades.upgrade_slots[i].name then 
			return true 
		end
	end
	return false
end

local function generate_shop()
	upgrades:generate_shop_slots()  
	for i = 1 , 3 do 
		gui.set_text(gui.get_node("Up_"..i.."_text"),upgrades.shop_slots[i].description)
		
		gui.play_flipbook(gui.get_node("Up_"..i.."_image"),icon_display( upgrades.shop_slots[i] ) ) 
	end

end

function on_message(self, message_id, message, sender)
	if message_id == hash("toggle_screen") then
		print("TOGGLE SCREEN IS TOGGLEEDED ")
		if  message.enabled then
			reset_shop_button_price()
			msg.post(".", "acquire_input_focus")
		else
			msg.post(".","release_input_focus")
		end
		
		for i in ipairs(self.all_nodes) do 
			gui.set_enabled(gui.get_node(self.all_nodes[i]),message.enabled)
		end
		
	end
	if message_id == hash("generate_shop_slots") then 
		upgrades:generate_shop_slots()  
		for i = 1 , 3 do 
			gui.set_text(gui.get_node("Up_"..i.."_text"),upgrades.shop_slots[i].description)
			gui.play_flipbook(gui.get_node("Up_"..i.."_image"), icon_display(upgrades.shop_slots[i])) 
		end
	end 
end

-- play_sfx("/Sound_manager#IR_shop_select")
-- play_sfx("/Sound_manager#IR_shop_buy")
-- play_sfx("/Sound_manager#IR_shop_errir")

function on_input(self, action_id, action)
	if not lockdown  then 
		-- if action_id == hash("reset") and  not self.button_selected_2  then
		-- 	self.button_selected_2 = true
		-- 	timer.delay(0.2,false,function() 
		-- 		self.button_selected_2 = false
		-- 	end)
		-- 	print("TS RAN BRUH 2")
		-- 	generate_shop()
		-- end

		if action_id == hash("action_but") and  not self.button_selected_2 then 
			self.button_selected_2 = true
			timer.delay(0.2,false,function() 
				self.button_selected_2 = false
			end)
			-- print("TS RAN BRUH ")
			if state_of_screen == "down" then   
				if buying_state then 
					if upgrades.shop_slots[cur_slot].price > hud_state.mana then 
						shake_selector()
						gui.set_text(gui.get_node("down_text_error"), ": Not enouught currency")
					elseif  upgrade_compare(upgrades.shop_slots[cur_slot].name) and upgrades.shop_slots[cur_slot].name ~= upgrades.upgrade_slots[cur_slot_down].name  then
						shake_selector()
						gui.set_text(gui.get_node("down_text_error"), ": Cant have multiple smae type")
					elseif not buying_state then 
						shake_selector()
						gui.set_text(gui.get_node("down_text_error"), ": no Upgrade selected")
					else
						upgrades:add_to_upgrade_slot(cur_slot_down , cur_slot )
						upgrades:modify_data_layer()
						gui.play_flipbook(gui.get_node("selector_onionskin"),"nothing")
						render_bottom_row()
						hud_state.mana = hud_state.mana - upgrades.shop_slots[cur_slot].price
						gui.set_text(gui.get_node("down_text_error"), ": Purchace -"..upgrades.shop_slots[cur_slot].price.." mana")
						local item_text =  upgrades.upgrade_slots[cur_slot_down].description
						gui.set_text(gui.get_node("down_1_text"),item_text)
						play_sfx("/Sound_manager#IR_shop_buy")
						gui.set_position(gui.get_node("selector_particle_2"),gui.get_position(gui.get_node("down_"..cur_slot_down.."_image")))
						gui.play_particlefx(gui.get_node("selector_particle_2"))
						bought = true
						buying_state = false
					end
				end
			elseif state_of_screen == "up_right" then   
				if cur_slot_Up_right == 1 then 
					quit_shop(self)
				elseif  cur_slot_Up_right == 2 then
					if hud_state.mana >= reset_shop_price then
						hud_state.mana = hud_state.mana - reset_shop_price
						reset_shop_button_price()
						generate_shop()
						gui.set_text(gui.get_node("price"),"Price : "..reset_shop_price)
						gui.play_particlefx(gui.get_node("selector_particle"))
						play_sfx("/Sound_manager#IR_shop_buy")
					else
						shake_selector("up_right")
					end
				end
			end
			if state_of_screen == "up" then 
				if not buying_state and next(upgrades.shop_slots[cur_slot]) ~= nil then --and upgrades.shop_slots[cur_slot].price <= hud_state.mana  then 
					play_sfx("/Sound_manager#IR_shop_select")
					gui.play_particlefx(gui.get_node("selector_particle"))
					buying_state = true
					--gui.set_position(gui.get_node("selector_onionskin"), gui.get_position(gui.get_node("selector")))
					gui.play_flipbook(gui.get_node("selector_onionskin"),icon_display(upgrades.shop_slots[cur_slot]))
					state_of_screen = "down"
					change_state_position(self,"neg")
					--hud_state.mana = hud_state.mana - upgrades.shop_slots[cur_slot].price
					gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"),"empty")
					gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("down_"..cur_slot_down.."_image"))+vmath.vector3(0,500,0), go.EASING_INEXPO, 0.2, 0 , function() 
						--state_of_screen = "down"
					end)
				else
					shake_selector("Up")
				end
			end
		end
		
		if not self.button_selected then 
			
			self.button_selected = true
			timer.delay(0.2,false,function() 
				self.button_selected = false
			end)

			if action_id == hash("left") or action_id == hash("right") then 
				gui.set_text(gui.get_node("down_text_error"), ": ")
				if state_of_screen == "down" then 
					if action_id == hash("right") then 
						cur_slot_down = cur_slot_down + 1

						if cur_slot_down > 6  then
							cur_slot_down =  1 
						end

					else
						cur_slot_down = cur_slot_down - 1
						if cur_slot_down <= 0  then
							cur_slot_down =  6
						end
					end 
					local item_text =  upgrades.upgrade_slots[cur_slot_down].description
					if item_text == nil then
						item_text = "Empty slot"
					end
					gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("down_"..cur_slot_down.."_image")), go.EASING_INEXPO, 0.2, 0, function() 
						gui.set_text(gui.get_node("down_1_text"),item_text)
					end) 

					play_sfx("/Sound_manager#select_sound")

				elseif state_of_screen == "up" or state_of_screen == "up_right"then
					if action_id == hash("left") and state_of_screen == "up" then
						state_of_screen = "up_right"
						if cur_slot_Up_right < 2 then 
							gui.set_text(gui.get_node("price"),"Price : ".."none")
						else
							gui.set_text(gui.get_node("price"),"Price : "..reset_shop_price)
						end
						gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot_Up_right.."_left")), go.EASING_INEXPO, 0.2)
						gui.animate(gui.get_node("selector"),"scale",gui.get_scale(gui.get_node("Up_"..cur_slot_Up_right.."_left")),  go.EASING_INEXPO,0.2)
						play_sfx("/Sound_manager#select_sound")
					elseif state_of_screen == "up_right" and action_id == hash("right") then
							state_of_screen = "up"
							gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_image")), go.EASING_INEXPO, 0.2)
							gui.animate(gui.get_node("selector"),"scale",gui.get_scale(gui.get_node("Up_"..cur_slot.."_image")), go.EASING_INEXPO,0.2)
							play_sfx("/Sound_manager#select_sound")
							if  next(upgrades.shop_slots[cur_slot])     ~= nil then 
								
									gui.set_text(gui.get_node("price"),"Price : "..upgrades.shop_slots[cur_slot].price)
									
								
							else
							

									gui.set_text(gui.get_node("price"),"Price : ".."none")
									
								
							end
						end
				end
				-- elseif state_of_screen == "Up" then
				-- 	if action_id == hash("right") then
				-- 		state_of_screen = "Up_right"
				-- 	else
				-- 		state_of_screen = "Up"
				-- 		gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_image")), go.EASING_INEXPO, 0.2)
				-- 	end
				
				

			elseif action_id == hash("up")  or action_id == hash("down") then
				if state_of_screen == "up" then 
					play_sfx("/Sound_manager#select_sound")
					if action_id == hash("down") then 
						
						cur_slot = cur_slot + 1

							if cur_slot > 4  then
								cur_slot =  1 
							end
				
					else
							cur_slot = cur_slot - 1
							if cur_slot <= 0  then
								cur_slot =  3 
							end
							
					end 
						--play_sfx("/Sound_manager#select_sound")
				elseif state_of_screen == "up_right" then
						if action_id == hash("down") then 
							cur_slot_Up_right = cur_slot_Up_right + 1

							if cur_slot_Up_right > 2  then
								cur_slot_Up_right =  1 
							end

						else
							cur_slot_Up_right = cur_slot_Up_right - 1
							if cur_slot_Up_right < 1  then
								cur_slot_Up_right =  2 
							end
						end 
						gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot_Up_right.."_left")), go.EASING_INEXPO, 0.2)
						if cur_slot_Up_right < 2 then 
							gui.set_text(gui.get_node("price"),"Price : ".."none")
						else
							gui.set_text(gui.get_node("price"),"Price : "..reset_shop_price)
						end
						--play_sfx("/Sound_manager#select_sound")
					end
					
				
					end
				

			if not buying_state then 
				if cur_slot <= 3 and state_of_screen == "up"  then 
					gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_image")), go.EASING_INEXPO, 0.2) 	
				elseif cur_slot == 4  then 
					cur_slot = 3 

					change_state_position(self,"neg")
					state_of_screen = "down"				
					gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("down_"..cur_slot_down.."_image"))+vmath.vector3(0,500,0), go.EASING_INEXPO, 0.2) 
			
				end
			end
			
			--gui.animate(gui.get_node("Up_"..cur_slot.."_text"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_text")), go.EASING_INEXPO, 0.2)
			if  next(upgrades.shop_slots[cur_slot])     ~= nil then 
				if  state_of_screen ~= "up_right" then 
					gui.set_text(gui.get_node("price"),"Price : "..upgrades.shop_slots[cur_slot].price)
					gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"),icon_display( upgrades.shop_slots[cur_slot] ) )
				end
			else
				if state_of_screen ~="up_right" then 
					
					gui.set_text(gui.get_node("price"),"Price : ".."none")
					gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"), "empty")
				end
			end

			if action_id == hash("up") and  state_of_screen  == "down"  then
				if buying_state then
	
						gui.play_flipbook(gui.get_node("selector_onionskin"),"nothing")
						
						buying_state = false
					end 
					if bought then 
						bought = false
						gui.set_text(gui.get_node("Up_"..cur_slot.."_text"),"SOLD!")	
						upgrades.shop_slots[cur_slot] = {}
					else
						if  next(upgrades.shop_slots[cur_slot]) ~= nil then 
							gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"),icon_display(upgrades.shop_slots[cur_slot]))
						end
					end
				change_state_position(self,"pos")
				gui.animate(gui.get_node("selector"), "position", gui.get_position(gui.get_node("Up_"..cur_slot.."_image"))-vmath.vector3(0,500,0), go.EASING_INEXPO, 0.2) 	
				state_of_screen = "up"
				gui.set_text(gui.get_node("down_text_error"), ": ")
				if  next(upgrades.shop_slots[cur_slot])     ~= nil then 
					gui.set_text(gui.get_node("price"),"Price : "..upgrades.shop_slots[cur_slot].price)
					gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"),icon_display(upgrades.shop_slots[cur_slot]) )
				else
					gui.set_text(gui.get_node("price"),"Price : ".."none")
					gui.play_flipbook(gui.get_node("Up_"..cur_slot.."_image"), "empty")
				end
			end
			
			


		end
		
		
	end

end

	


	


