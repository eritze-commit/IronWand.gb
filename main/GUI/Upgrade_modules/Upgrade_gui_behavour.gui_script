local cur_slot = 1
local enabled = false  
local state_of_screen = "up"
local button_cooldown = 0.2
local cur_slot_down = 1 
local cur_slot_Up_right = 1
local buying_state = false
local bought = false
local shop_reset_selector = false
local reset_shop_price = 0

local lockdown = false

