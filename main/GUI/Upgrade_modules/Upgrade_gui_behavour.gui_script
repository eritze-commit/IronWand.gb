local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
local cur_slot = 1

function init(self)
	msg.post(".", "acquire_input_focus")
	self.all_nodes = {"Up_1_image","Up_1_text","Up_2_image","Up_2_text","Up_3_image","Up_3_text","backdrop","mana"}
	self.all_upgrade_text_nodes = {"Up_1_text","Up_2_text"}
	self.move_up_amount = 100
	upgrades:generate_shop_slots()

	timer.delay(1,true, function() 
		upgrades:generate_shop_slots()
		for i = 1 , 3 do 
			gui.set_text(gui.get_node("Up_"..i.."_text"),upgrades.shop_slots[i].description)
			gui.play_flipbook(gui.get_node("Up_"..i.."_image"),upgrades.shop_slots[i].name)
		end
	end)
	
	pprint(upgrades.upgrade_master_list[1].description)
end

