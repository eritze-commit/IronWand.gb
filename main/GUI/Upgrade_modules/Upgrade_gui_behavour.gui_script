	self.button_selected = false 
	self.button_selected_2 = false 
	if  enabled then
		msg.post(".", "acquire_input_focus")
	end
	self.all_nodes = {"Up_1_image","Up_1_text","Up_2_image","Up_2_text","Up_3_image","Up_3_text","backdrop","mana","selector","price","mana_icon",
	"down_1_image","down_2_image","down_3_image","down_4_image","down_5_image","down_6_image","down_1_text","selector_onionskin","down_text_error","selector_particle",
	"selector_particle_2","Up_1_left","Up_2_left"}
	
	-- self.move_up_amount = 100
	-- upgrades:generate_shop_slots()

	--upgrades:add_to_upgrade_slot(1 , 1 )
	--FIRST INDEX IS THE UPGRADE PlAYER SLOT YOURE ADDING TOO SECOND IS THE SHOP SLOT YOURE GETTING DATA FROM 
	--upgrades:add_to_upgrade_slot(4 , 2 )
	
	-- upgrades:modify_data_layer()
	-- print(upgrades.data_layer["bounce"].bounce_chance)

	-- pprint(upgrades.data_layer)
	-- pprint(upgrades.shop_slots)
	-- pprint(upgrades.upgrade_slots)

	-- timer.delay(0.1,false, function() 
	-- 	upgrades:generate_shop_slots()  
	-- 	for i = 1 , 3 do 
	-- 		gui.set_text(gui.get_node("Up_"..i.."_text"),upgrades.shop_slots[i].description)
	-- 		gui.play_flipbook(gui.get_node("Up_"..i.."_image"),upgrades.shop_slots[i].name) 
	-- 	end
	-- end)
	
	--pprint(upgrades.upgrade_master_list[1].description)
	for i in ipairs(self.all_nodes) do 
		
		gui.set_enabled(gui.get_node(self.all_nodes[i]),enabled)
	end
end

