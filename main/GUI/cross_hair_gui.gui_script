
local cros_pos  = require("main.Player_assets.G-UNZ.cross_hair_data")

function init(self)
	gui.set_visible(gui.get_node("box"),false)
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	gui.set_position(gui.get_node("box"), cros_pos.cros_poss )
	--print("CROSSSS POSSS ",cros_pos.cros_poss)
	gui.set(gui.get_node("box"), "euler.z", gui.get(gui.get_node("box"), "euler.z") + 0.1 )
end

function on_message(self, message_id, message, sender)
	if message_id == hash("toggle") then
		gui.set_visible(gui.get_node("box"),message.toggle)
	end

end

