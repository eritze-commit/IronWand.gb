local Pstate = require "main.Player_assets.Player_state_module"

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.play_particlefx(gui.get_node("Dust"))
	self.start_pos_node_start = gui.get_position(gui.get_node("start"))
	self.button_default_color = vmath.vector4(0.9, 0.9, 0.9, 1)
	self.node_highlight_color = vmath.vector4(1, 1, 1, 1)
	self.button_states = {"none","start"}
	self.cur_button_state = 1
	self.last_node_selected = nil
	self.cur_selected  = nil
	self.button_selected = false
	self.start_pos_node_logo = gui.get_position(gui.get_node("logo"))
	self.target_pos = vmath.vector3(math.random(),math.random(),0) * 2
	timer.delay(3,true , function() 
		if math.random(1,10) < 9 then 
			local x_module = math.random(0,1) == 0 and 1 or -1
			local y_module = math.random(0,1) == 0 and 1 or -1
			self.target_pos = vmath.vector3(math.random()*x_module,math.random()*y_module,0) * 2
		else
			self.target_pos = 6767
		end
	end)
	gui.set(gui.get_node("start"),"color",self.button_default_color)
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end
local nex_pos_1 = 0
local nex_pos_2 = 0

function update(self, dt)
	local logo_node  = gui.get_position(gui.get_node("logo"))
	
	local start_node =  gui.get_position(gui.get_node("start"))

	if self.target_pos ~= 6767 then 
		nex_pos_1 = vmath.lerp(0.02,logo_node,logo_node + self.target_pos)
		
		nex_pos_2 = vmath.lerp(0.02,start_node,start_node + self.target_pos)
	else
		 nex_pos_1 = vmath.lerp(0.01,logo_node,self.start_pos_node_logo)
		 nex_pos_2 = vmath.lerp(0.01,start_node,self.start_pos_node_start)
	end

	gui.set_position(gui.get_node("logo"), nex_pos_1)
	gui.set_position(gui.get_node("start"), nex_pos_2)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end
local function Flip_gui_state(self,state) 
	gui.set_enabled(gui.get_node("start"),state)
	gui.set_enabled(gui.get_node("logo"),state)
	gui.set_enabled(gui.get_node("backDrop"),state)
	gui.set_enabled(gui.get_node("Dust"),state)
	self.button_selected = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_gui") then
		--self.button_selected = false
		print("GOT MESSAGE SHOW GUI ")
		Flip_gui_state(self,message.show) 

		
		
	end
end



function on_input(self, action_id, action)
	if not self.button_selected then 
		if action_id == hash("down") or action_id == hash("up") then 
			
			self.button_selected = true
			timer.delay(0.2,false,function() 
				self.button_selected = false
			end)
		self.cur_button_state = self.cur_button_state + 1 
		if self.cur_button_state > #self.button_states then
			self.cur_button_state = 1 
		end
		if self.button_states[self.cur_button_state] ~= "none" then
			self.last_node_selected = self.button_states[self.button_state]
			gui.set(gui.get_node("start"),"color",self.node_highlight_color)
			--gui.set_color()
		else
			gui.set(gui.get_node("start"),"color",self.button_default_color)
		end
		
	end
	if action_id == hash("action_but") and not self.button_selected  then 
		if self.button_states[self.cur_button_state] ~= "none" then
			self.button_selected = true
			timer.delay(0.2,false,function() 
				self.button_selected = false
			end)
			msg.post("/global#Game_state_manager","change_state",{state = "playing"})
			end
		end
	end
	-- Add input-handling code here. The game object this script is attached to
	-- must have acquired input focus:
	--
	--    msg.post(".", "acquire_input_focus")
	--
	-- All mapped input bindings will be received. Mouse and touch input will
	-- be received regardless of where on the screen it happened.
	-- Learn more: https://defold.com/manuals/input/
	-- Remove this function if not needed
end

