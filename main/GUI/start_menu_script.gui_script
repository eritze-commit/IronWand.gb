local nex_pos_1 = 0
local nex_pos_2 = 0

function update(self, dt)
--	local logo_node  = gui.get_position(gui.get_node("logo"))
	
	local nex_pos = vmath.vector3()
	for i = 1, #self.all_nodes do 
	local start_node =  gui.get_position(gui.get_node(self.all_nodes[i].name))
	if self.target_pos ~= 6767 then 
		 nex_pos = vmath.lerp(0.02,start_node ,start_node + self.target_pos)
		
	else
		
		  nex_pos = vmath.lerp(0.01,start_node,self.all_nodes[i].start_pos)
		-- nex_pos_2 = vmath.lerp(0.01,start_node,self.start_pos_node_start)
	end
		gui.set_position(gui.get_node(self.all_nodes[i].name), nex_pos)
	end
	

--	gui.set_position(gui.get_node("logo"), nex_pos_1)
--	gui.set_position(gui.get_node("start"), nex_pos_2)
	--gui.set_position(gui.get_node("defold_logo"), nex_pos_2)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end
local function Flip_gui_state(self,state) 
	for i = 1 ,#self.every_node do 
--		pprint("self node ",self.all_nodes[i])
		gui.set_enabled(gui.get_node( self.every_node[i] ),state)
	end
	
	-- gui.set_enabled(gui.get_node("start"),state)
	-- gui.set_enabled(gui.get_node("logo"),state)
	-- gui.set_enabled(gui.get_node("backDrop"),state)
	-- gui.set_enabled(gui.get_node("Dust"),state)
	-- gui.set_enabled(gui.get_node("info"),state)
	-- gui.set_enabled(gui.get_node("settings"),state)

	--gui.set_enabled(gui.get_node("defold_logo"),state)
	self.button_selected = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_gui") then
		--self.button_selected = false
		--print("GOT MESSAGE SHOW GUI ")
		Flip_gui_state(self,message.show) 

		
		
	end
	if message_id == hash("settings_back") then
		timer.delay(0.2,false, function() 
			msg.post(".","acquire_input_focus")
		end)
		msg.post(".","show_gui",{show = true})
		
	end
end

local but_selected

function on_input(self, action_id, action)
	if not but_selected then
	if  action_id ~= hash("down") and action_id ~= hash("up") and action_id ~= hash("action_but")  then
		if action.pressed then
			but_selected = true
			timer.delay(0.5,false,function() 
				but_selected = false
			end)
			gui.set_visible(gui.get_node("info_text"),true)
			gui.set_visible(gui.get_node("info_text_box"),true)
			--print("action is not true ran ")
		end
		
		end
	end
	if not self.button_selected then 
		
		
		if action_id == hash("down") or action_id == hash("up") then 
			gui.set_visible(gui.get_node("info_text"),false)
			gui.set_visible(gui.get_node("info_text_box"),false)
			self.button_selected = true
			timer.delay(0.15,false,function() 
				self.button_selected = false
			end)
		if action_id == hash("down") then
		
			self.cur_button_state = self.cur_button_state + 1 
			if self.cur_button_state > #self.button_states then
				self.cur_button_state = 1 
			end
		else
			self.cur_button_state = self.cur_button_state - 1 
			if self.cur_button_state <= 0  then
				self.cur_button_state = #self.button_states
			end
		end
		
		gui.set(gui.get_node(self.last_node_selected),"color",self.button_default_color)
		gui.set(gui.get_node(self.button_states[self.cur_button_state]),"color",self.node_highlight_color)
		self.last_node_selected = self.button_states[self.cur_button_state ]
		menu_sfx("menu_move")
			--gui.set_color()
		
	end
	if action_id == hash("action_but") and not self.button_selected  then 
		gui.set_visible(gui.get_node("info_text"),false)
		gui.set_visible(gui.get_node("info_text_box"),false)
		if self.cur_button_state ~= 0 then
			self.button_selected = true
			timer.delay(0.2,false,function() 
				self.button_selected = false
			end)
				
				self.button_actions[self.button_states[self.cur_button_state]]()
				menu_sfx("menu_select")
			end
		end
	end
	-- Add input-handling code here. The game object this script is attached to
	-- must have acquired input focus:
	--
	--    msg.post(".", "acquire_input_focus")
	--
	-- All mapped input bindings will be received. Mouse and touch input will
	-- be received regardless of where on the screen it happened.
	-- Learn more: https://defold.com/manuals/input/
	-- Remove this function if not needed
end

