function update(self, dt)
	--[[
	local w = render.get_window_width()
	local h = render.get_window_height()
	--]]
	
	local cam_pos =  go.get_position("Player_ROOT/camera")
	
	go.set_position(vmath.vector3(cam_pos.x,cam_pos.y,0), ".")
	self.time = self.time + dt
	go.set("#posProc","uTime",vmath.vector4(self.time,0,0,0))
	--[[
	if w ~= last_w and h ~= last_h then 
		go.set_scale(vmath.vector3(w,h,0), ".")
		last_h = h
		last_w = w 
	end
	--]]
	
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

