local function rotate_music() 
	local s_s_max = 1.3
	local s_s_min = 0.7
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	local random_slice = math.random(1, 9)
	sound.play("/music_box#sng_slice_"..random_slice,{speed = random_offset },function() 
		rotate_music()
	end)
end
function init(self)
	sound.set_group_gain("sfx",0.4)
	sound.set_group_gain("music",0.3)
	rotate_music()
end

