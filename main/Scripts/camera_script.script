	-- Remove this function if not needed
end

function update(self, dt)
	
	local camera_pos = go.get_position("#")
		local pl_pos =  go.get_position("Pl_Sprite")
		--local x_y = vmath.vector3(pl_pos.x,pl_pos.y,730)
		local lerp_vl = 0.06
		

		local target = vmath.vector3(
			pl_pos.x ,
			pl_pos.y , 
			camera_pos.z
			) 

			local new_pos = vmath.lerp(lerp_vl,camera_pos,target)
			go.set_position(new_pos, "#")
		
		--print("camera pos ", target)

	
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

