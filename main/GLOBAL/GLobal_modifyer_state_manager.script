function on_message(self, message_id, message, sender)
	if message_id == hash("update_floor_values") then
		global.floor_t = math.max(0,math.min(1, map_state.map_cur_floor / global.max_floor))
		--[[ magic euler number  and 0.03 another magic number -]]
		global.expo_decay = 1 * (1 - (2.71828^-0.01)^ math.min(100,map_state.map_cur_floor) )
		
		--global.expo_decay = 1 * (1 - (2.71828^-0.07)^ math.max(0,math.min(100,map_state.map_cur_floor) ))
		--print("GLOBAL EXPO DECAY ",global.expo_decay," ,map state ", map_state.map_cur_floor)
		global.floor_linear_scalar = math.floor(global.floor_t * 100)
		global.map_tint = -(global.floor_t * 0.25)
		global.enemie_floor_hp_scale = 1 + (map_state.map_cur_floor / global.max_floor) * global.health_scale 
		global.enemy_spawn_scale = math.floor(global.floor_t * 25)
		global.enemy_spawn_delay_scalar = 3 + (global.floor_t * 25)
	end
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

