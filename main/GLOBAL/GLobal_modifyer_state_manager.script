function update(self, dt)
	--print("MAP  SCALAR ",global.floor_linear_scalar)
	if  map_state.map_cur_floor ~= last_map_state_floor then 
		last_map_state_floor = map_state.map_cur_floor
		floor_t = map_state.map_cur_floor / global.max_floor
		global.floor_linear_scalar = 0.7 + ( floor_t  * 4.3 )
		global.map_tint = -(floor_t * 0.25)
		global.enemy_spawn_scale = math.floor(floor_t * 40)
		global.enemy_spawn_delay_scalar = 10 + (floor_t * 50)
	end	
end

