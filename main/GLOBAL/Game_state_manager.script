end

function on_message(self, message_id, message, sender)
	if message_id == hash("change_state") then
		if self.avalable_states[message.state][self.curent_state] then 
			self.curent_state = message.state

			if self.curent_state == "playing" then 
				msg.post("/music_box#music_box","stop_music")
				self.curent_state = "not_playing"
				for i = #floor_timers , 1, -1 do
					timer.cancel(floor_timers[i])
--					print("timer ",i," timers ",floor_timers[i])
					table.remove(floor_timers,i)
				end
				msg.post("/Gui_collection/hud#hud","cancel_up_floor")
				msg.post("/music_box#music_box","pause_music",{paused = false})
				msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","clear_enemies")
				msg.post("/Player_ROOT/gun_cont#gun_controller","acquire_input_focus")
				msg.post("/Player_ROOT/Player#Player_Script","give_input")
				msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = true})
				active.cur_scene_active = false 

				msg.post("Player_ROOT/Pl_Sprite#Pl_Sprite_Script","player_idle")
				if not debug.floor_reset then
					for slot, item in ipairs(upgrades.upgrade_slots) do 
							upgrades.upgrade_slots[slot] = {}
					end
				end
				upgrades:modify_data_layer()	
				window.set_mouse_lock(true)
				Pstate.health = Pstate.max_health
				shop_floor = shop_floor_incriment
				global.round_total_time = 0 
				shop_floor = shop_floor_incriment
				if not debug.token_reset then
					map_state.mana = 0 
				end
				if not debug.floor_reset then
					map_state.map_cur_floor = 0
				end
				if game_state.paused then
					msg.post("/global#Game_state_manager","change_state",{state = "paused",extra = false})
				end
				msg.post("/Gui_collection/hud#hud","health_bar_change",{health = Pstate.health , max_health = Pstate.max_health})		
				--print("RIght state",message.state)
				sound.play("/Sound_manager#player_spawn")
				--map_state.map_cur_floor = 0
				msg.post("/Map#Auto_Tiler","reset_floor_state")
				msg.post("/global#GLobal_modifyer_state_manager","update_floor_values")
				msg.post("/Gui_collection/StartMenu#Start GUi","show_gui",{show = false}) 
				while active.cur_scene_active do 
						active.cur_scene_active = false			
				end
				
				
				-- 730.0 camera z cord 
				msg.post("/Map#Auto_Tiler","asm",{map = 1})
				go.set_position(vmath.vector3(-200,-200,730.0), "/Player_ROOT/camera")
				
					while go.get_position("/Player_ROOT/Player") ~= vmath.vector3((21* 16)+8,(11*16)+8,0) do 
						go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
					end
				timer.delay(0.5,false, function() 
					Pstate.alive = true
					self.curent_state = "playing"
				end)
				if self.current_enemy_timer_handle ~= -67 then
					timer.cancel(self.current_enemy_timer_handle)
				end
				self.current_enemy_timer_handle = timer.delay(5,false, function() 
					msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","enemy_reset") 
				end)

				
				msg.post("/Gui_collection/hud#hud","show_gui",{show = true})
				msg.post("/Gui_collection/hud#hud","acquire_input_focus")
				msg.post("/Gui_collection/StartMenu#Start GUi","release_input_focus")
				settings.music_damper = 1
				sound.set_group_gain("music",settings.music_vol/settings.music_damper)
				timer.delay(0.2,false , function()
					while not active.cur_scene_active do 
						active.cur_scene_active = true
					end
			  end ) 
			elseif self.curent_state == "menu" then
			--print("timer ", #floor_timers)
				for i = #floor_timers , 1, -1 do
					timer.cancel(floor_timers[i])
					--print("timer ",i," timers ",floor_timers[i])
					table.remove(floor_timers,i)
				end
				msg.post("/Gui_collection/hud#hud","cancel_up_floor")
				msg.post("/Player_ROOT/gun_cont#gun_controller","release_input_focus")
				msg.post("/Player_ROOT/Player#Player_Script","release_input")
				msg.post("/music_box#music_box","pause_music",{paused = false})
				msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = false})
				settings.music_damper = 3
				sound.set_group_gain("music",settings.music_vol/settings.music_damper)
				self.curent_state = "menu"
				msg.post("/Gui_collection/StartMenu#Start GUi","show_gui",{show = true}) 
				msg.post("/Gui_collection/hud#hud","release_input_focus")
				window.set_mouse_lock(false)
				timer.delay(0.3, false , function() 
					msg.post("/Gui_collection/StartMenu#Start GUi","acquire_input_focus")
				end)
			
			elseif self.curent_state == "up_floor" then   
				self.curent_state = "playing"
				map_state.map_cur_floor = map_state.map_cur_floor + 1
				--go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
				msg.post("/Gui_collection/hud#hud","update_pause_values")
				msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","clear_enemies")
				if map_state.map_cur_floor == shop_floor then
						
					floor_timers[#floor_timers+1] = timer.delay(1,false,function()
							if Pstate.alive then
								active.cur_scene_active = false
							--msg.post("/Gui_collection/hud#hud","show_gui",{show = false})
							
								msg.post("/Player_ROOT/gun_cont#gun_controller","release_input_focus")
								msg.post("/Player_ROOT/Player#Player_Script","release_input")
								msg.post("Player_ROOT/Pl_Sprite#Pl_Sprite_Script","player_idle")
								msg.post("/Map#Auto_Tiler","cls")
							end
						end)
					floor_timers[#floor_timers+1] = timer.delay(2,false,function()
							if Pstate.alive then
								msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = false})
								window.set_mouse_lock(false)
								msg.post("/Gui_collection/hud#hud","release_input_focus")
								self.curent_state = "up_floor"
								msg.post("/global#Game_state_manager","change_state",{state = "shop"})
							end

						end)
				else
					if not game_state.paused then
						window.set_mouse_lock(true)
						msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = true })
					end

					
					msg.post("/Player_ROOT/gun_cont#gun_controller","acquire_input_focus")
					msg.post("/Player_ROOT/Player#Player_Script","give_input")
					msg.post("/global#GLobal_modifyer_state_manager","update_floor_values")
					floor_timers[#floor_timers+1] = timer.delay(2,false,function()
						msg.post("/Gui_collection/hud#hud","release_input_focus")
						--msg.post("/Gui_collection/hud#hud","show_gui",{show = false})
						msg.post("/Gui_collection/hud#hud","map_info",{floor = 1 })
						
						--go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
					end)
	
					floor_timers[#floor_timers+1] = timer.delay(3,false,function()
						active.cur_scene_active = false
						--msg.post("/Gui_collection/hud#hud","show_gui",{show = true })
						go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
						timer.delay(0.1, false , function() 
							while active.cur_scene_active do 
								active.cur_scene_active = false
								print("setting cur_scene")
							end
							msg.post("/Map#Auto_Tiler","asm",{map = 1})
							while go.get_position("/Player_ROOT/Player") ~= vmath.vector3((21* 16)+8,(11*16)+8,0) do 
								print("Setting position")
								go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
							end
						end)
						go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
						
						timer.delay(0.2,false,function() 
							while not active.cur_scene_active do 
								active.cur_scene_active = true
								print("setting cur_scene 2")
							end
 
						end)
						
						if upgrades.data_layer["shield"].owns == 1 then
							if upgrades.data_layer["shield"].active == 0 then
								if upgrades.data_layer["shield"].buffer > 0 then 
									upgrades.data_layer["shield"].buffer = upgrades.data_layer["shield"].buffer - 1 
								end
								if upgrades.data_layer["shield"].buffer <= 0 then
									upgrades.data_layer["shield"].buffer = upgrades.data_layer["shield"].max_recharge
									upgrades.data_layer["shield"].active = 1 
								end
							end
						end
					end)
					floor_timers[#floor_timers+1] = timer.delay(5,false,function() 
						msg.post("/Gui_collection/hud#hud","acquire_input_focus")
					end)
					floor_timers[#floor_timers+1] = timer.delay(6,false,function() 

						msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","enemy_reset")
						if Pstate.alive then
							for i = #floor_timers , 1, -1 do
								timer.cancel(floor_timers[i])
					--print("timer ",i," timers ",floor_timers[i])
								table.remove(floor_timers,i)
							end
						end
						--go.set_position(vmath.vector3((21* 16)+8,(11*16)+8,0), "/Player_ROOT/Player")
					end)
				end
			elseif self.curent_state == "shop" then 
				shop_floor = shop_floor + shop_floor_incriment
				msg.post("/Gui_collection/upgrade#Upgrade_interface","toggle_screen",{enabled = true })
				msg.post("/Gui_collection/upgrade#Upgrade_interface","generate_shop_slots")
			elseif self.curent_state == "dead" then
				self.curent_state = "dead"
				msg.post("/Player_ROOT/gun_cont#gun_controller","release_input_focus")
				msg.post("/Player_ROOT/Player#Player_Script","release_input")
				active.cur_scene_active = false 
				Pstate.alive = false
				--shop_floor = shop_floor_incriment
				--map_state.mana = 0
				msg.post("/music_box#music_box","pause_music",{paused = true})
				sound.play("/Sound_manager#player_death")
				msg.post("/Gui_collection/hud#hud","show_gui",{show = false})
				window.set_mouse_lock(false)
				msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = false})
				msg.post("/global#Game_state_manager","change_state",{state = "paused",extra = false})
				msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","clear_enemies",{clea = true})
				-- timer.delay(0.5,false,function()
				-- 	msg.post("/Gui_collection/hud#hud","map_info",{bar = nil})
				-- end)
				
				msg.post("/Gui_collection/death#death_screen","toggle_game_over",{state = true}) 
				msg.post("Player_ROOT/Pl_Sprite#Pl_Sprite_Script","player_dead")
				timer.delay(1.5,false,function() 
					
					msg.post("/Gui_collection/death#death_screen","acquire_input_focus")
					msg.post("/Gui_collection/death#death_screen","toggle_game_over",{state = false,floor = map_state.map_cur_floor}) 
					print("global cur diff ", global.cur_diff)
					msg.post("/Gui_collection/death#death_screen","toggle_death_screen",{toggle = true,floor_state = map_state.map_cur_floor , round_time = global.round_total_time }) 
					--msg.post("/Map#Auto_Tiler","cls")
--					go.set_position(vmath.vector3(0,0,0,0), "/Player_ROOT/Player")
				--msg.post("/global#Game_state_manager","change_state",{state = "menu"})
					
				end)
			elseif self.curent_state == "paused" then
				
				game_state.paused = message.extra
				window.set_mouse_lock(not message.extra)
				if not game_state.paused then 
					self.curent_state = "playing"
				end
				if self.current_state ~= "shop" then				
					msg.post("/Player_ROOT/go#cross_hair","toggle",{toggle = not message.extra})
				end
				msg.post("/music_box#music_box","pause_music",{paused = message.extra})
				msg.post("/Gui_collection/hud#hud","paused",{visibles = message.extra})
				
			elseif self.curent_state == "combo" then
				self.curent_state = "playing"
				combo_state = combo_state + 1
				if not timer_active then
					timer_active = true
					timer.delay(10, false, function() 
						timer_active = false
						msg.post("/Gui_collection/hud#hud","update_combo",{visible  = timer_active, combo = combo_state, color = vmath.vector4(1,0,1,1),strenght =0.5+(combo_state/20)*5 })
						combo_state = 0
					end)
				end
				msg.post("/Gui_collection/hud#hud","update_combo",{visible  = timer_active, combo = combo_state, color = vmath.vector4(1,1.0-(combo_state/20),1,1), strenght = 0.5+(combo_state/20)*5 })
				sound.stop("/Sound_manager#combo_sfx")
				sound.play("/Sound_manager#combo_sfx",{speed = 0.5 + (combo_state/20)* 1.5 , gain = (combo_state/20)* 0.7 })
				
			end
			
		else
			print("SENDER OF WRONG STATE ",sender,"sent state",message.state,"CUR STATE ",self.curent_state)
		end
		 

	end
end

