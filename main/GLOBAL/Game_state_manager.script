local Pstate = require("main.Player_assets.Player_state_module")
local map_state = require("main.Player_assets.G-UNZ.Hud_state")
local active = require("main.Enemy_Assets.drops.spawnded_items_data")
local game_state = require("main.GLOBAL.in_game")
local global = require("main.GLOBAL.GLOBAL")
local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")



function init(self)
	self.curent_state = "menu"
	self.avalable_states  = {
		["menu"] = {["paused"]=true,["dead"]=true },
		["playing"] = {["menu"]=true,["dead"]=true },
		["dead"] = {["playing"]=true,["paused"]=true},
		["paused"] = {["playing"]=true,["paused"]=true,["shop"]=true,["menu"]=true},
		["up_floor"] = {["playing"]=true,["shop"]=true,["paused"]=true},
		["game_over"] = {["dead"]=true},
		["combo"] = {["playing"]=true},
		["shop"] = {["up_floor"]=true}
	}
end

local combo_state = 0
local timer_active = false
local paused = false
local shop_floor = 2 
local shop_floor_incriment = 2

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

