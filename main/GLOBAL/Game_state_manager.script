local Pstate = require("main.Player_assets.Player_state_module")
local map_state = require("main.Player_assets.G-UNZ.Hud_state")
local active = require("main.Enemy_Assets.drops.spawnded_items_data")


function init(self)
	self.curent_state = "menu"
	self.avalable_states  = {
		["menu"] = {["paused"]=true},
		["playing"] = {["menu"]=true},
		["dead"] = {["playing"]=true},
		["paused"] = {["playing"]=true},
		["up_floor"] = {["playing"]=true},
		["game_over"] = {["dead"]=true},
		["combo"] = {["playing"]=true}
	}
end

local combo_state = 0
local timer_active = false

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

