local debug = require  "main.GLOBAL.debug_data" 
local Pstate = require("main.Player_assets.Player_state_module")
local map_state = require("main.Player_assets.G-UNZ.Hud_state")
local active = require("main.Enemy_Assets.drops.spawnded_items_data")
local game_state = require("main.GLOBAL.in_game")
local global = require("main.GLOBAL.GLOBAL")
local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
local settings = require("main.GLOBAL.settings_data")


function init(self)
	self.current_enemy_timer_handle = -67
	self.curent_state = "menu"
	self.avalable_states  = {
		["menu"] = {["paused"]=true,["dead"]=true ,["playing"]=true},
		["playing"] = {["menu"]=true,["dead"]=true ,["playing"]=true,["paused"] = true },
		["dead"] = {["playing"]=true,["paused"]=true},
		["paused"] = {["playing"]=true,["paused"]=true,["shop"]=true,["menu"]=true},
		["up_floor"] = {["playing"]=true,["shop"]=true,["paused"]=true},
		["game_over"] = {["dead"]=true},
		["combo"] = {["playing"]=true},
		["shop"] = {["up_floor"]=true}
	}
	msg.post("/Map#Auto_Tiler","asm",{map = 1})
	local player_pos = go.get_position("Player_ROOT/Pl_Sprite")
	go.set_position(vmath.vector3(player_pos.x,player_pos.y,730.0), "/Player_ROOT/camera")
end

local combo_state = 0
local floor_timers = {}
local timer_active = false
local paused = false
local shop_floor = 2 
local shop_floor_incriment = 2

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

