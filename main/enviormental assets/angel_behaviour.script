local Pstate = require "main.Player_assets.Player_state_module"
local env = require("main.Scripts.eviorment_data")

function init(self)
	self.durab = 5
	self.can_attack = true
	self.first_pos = go.get_position(".")
	self.shaking = false
	self.sound_enabled = false 
	self.objects_normal = vmath.vector3()
	self.sound_gain = 1.0
	self.cord_key = nil
	local s_s_max = 0.15
	local s_s_min = 0
	local neg_mod = math.random(0,1) == 0 and 1 or -1  
	self.default_tint =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	self.default_tint = self.default_tint * neg_mod
	go.set("#sprite","color_mod",vmath.vector4(self.default_tint,0,0,0)) 
end

function final(self)
	if self.sound_enabled then 
		local s_s_max = 1.1
		local s_s_min = 0.7
		local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))

		env.statue_pos[self.cord_key] = false
		
		
		sound.stop("/Sound_manager#break_explode_sound")
		sound.play("/Sound_manager#break_explode_sound",{speed = random_offset, gain = self.sound_gain-0.1 })
		particlefx.stop("#explode_triangle_fx")
		particlefx.play("#explode_triangle_fx")
		msg.post("/Drop_Spawner#Drop_spawner","spawn_drop",{position = go.get_position("."), max_drop = 2, min_drop = 0 })
	end
end

