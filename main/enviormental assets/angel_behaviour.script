function init(self)
	self.durab = 5
	self.can_attack = true
	self.first_pos = go.get_position(".")
	self.shaking = false
	self.sound_enabled = false 
	self.objects_normal = vmath.vector3()
end

function final(self)
	if self.sound_enabled then 
		sound.stop("#break_explode_sound")
		sound.play("#break_explode_sound")
	end
	particlefx.stop("#explode_triangle_fx")
	particlefx.play("#explode_triangle_fx")
end

