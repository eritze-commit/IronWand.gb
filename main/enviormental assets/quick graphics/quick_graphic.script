function on_message(self, message_id, message, sender)
	if message_id == hash("spawn") then
		sprite.play_flipbook("#sprite",message.graphic)
		go.animate("#sprite","alpha",go.PLAYBACK_ONCE_FORWARD,vmath.vector4(0,0,0,0),go.EASING_INSINE,message.duration,0,function() 
			go.delete(".")
		end)
	end
end

