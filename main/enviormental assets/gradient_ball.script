
function on_message(self, message_id, message, sender)
	if message_id == hash("change_shape") then
		--go.set_scale(".")
		if message.type == "shadow" then
			local pos = go.get_position(".")
			pos.z = 0.4
			go.set_position(pos,"." )
			local random_scale = 1 + (math.random()*1 )
			sprite.play_flipbook("#sprite","purpl")
			go.animate(".","scale",go.PLAYBACK_ONCE_FORWARD,vmath.vector3(random_scale,random_scale,0,0),go.EASING_INSINE,0.01)
			go.animate("#sprite","alpha",go.PLAYBACK_ONCE_FORWARD,vmath.vector4(0.4+(math.random() * 0.4 ),0,0,0),go.EASING_INSINE,0.01)
		end
		if message.type == "back" then
			local pos = go.get_position(".")
			pos.z = -2
			go.set_position(pos,"." )
			local random_scale = 4 + (math.random()*2)
			local sprites = {"purpl","lvndr"}
			sprite.play_flipbook("#sprite",sprites[math.random(1,#sprites)])
			go.animate(".","scale",go.PLAYBACK_ONCE_FORWARD,vmath.vector3(random_scale,random_scale,0,0),go.EASING_INSINE,0.01)
			go.animate("#sprite","alpha",go.PLAYBACK_ONCE_FORWARD,vmath.vector4(0.2+(math.random() * 0.2 ),0,0,0),go.EASING_INSINE,0.01)
		end
		if message.type == "middle" then
			local pos = go.get_position(".")
			pos.z = 0.45
			go.set_position(pos,"." )
			local random_scale = 1 + (math.random()*1  )
			go.animate(".","scale",go.PLAYBACK_ONCE_FORWARD,vmath.vector3(random_scale,random_scale,0,0),go.EASING_INSINE,0.01)
			go.animate("#sprite","alpha",go.PLAYBACK_ONCE_FORWARD,vmath.vector4(0.2+(math.random() * 0.4 ),0,0,0),go.EASING_INSINE,0.01)
		end
	end
end

