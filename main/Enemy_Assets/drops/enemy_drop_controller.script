
local active = require("main.Enemy_Assets.drops.spawnded_items_data")
local hud_drop_data = require("main.Player_assets.G-UNZ.Hud_state")
local game_state = require("main.GLOBAL.in_game")

function init(self)
	self.cur_item = ""
	timer.delay(20, false, function() 
		go.delete(".")
	end)	
	particlefx.play("#drop_Pfx")
	particlefx.play("#drops_spawn_fx")
	--print("OBJECT SPAWN  ITEM SPAWN SPANDER ")

--	self.cur_item = avalible_items[math.random(1,#avalible_items)]
	
	
end
local action_table = {
	["gun_mag"] = function()  msg.post("/Player_ROOT/gun_cont#gun_controller","mag_pickup")          end,
	["heart"] = function()  msg.post("/Player_ROOT/Pl_Sprite#Pl_Sprite_Script","heart_pickup") end,
	["mana_orb"] = function() hud_drop_data.mana = hud_drop_data.mana + 1   end, 
	["mana_star"] = function() hud_drop_data.mana = hud_drop_data.mana + 1   end, 
}

function final(self)
	local s_s_max = 2
	local s_s_min = 1
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	sound.stop("/Sound_manager#pickup_sfx")
	sound.play("/Sound_manager#pickup_sfx",{speed =  random_offset, gain  = 0.6})

	particlefx.stop("#drops_spawn_fx")
	particlefx.play("#drops_spawn_fx")
	
end

function update(self, dt)
	if active.cur_scene_active then
		if not game_state.paused then  
		go.set_position(vmath.lerp(0.01*math.random(0,5),go.get_position("."),go.get_position("/Player_ROOT/Player"), "."))
		if vmath.length(go.get_position("/Player_ROOT/Player") - go.get_position(".") ) < 10 then 
			--msg.post("")
			action_table[self.cur_item]()
			go.delete(".")
		end
		end
	else
		go.delete()
	end
end

