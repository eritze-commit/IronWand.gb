go.property("color_shift",vmath.vector4())
local active = require("main.Enemy_Assets.drops.spawnded_items_data")

function init(self)
	self.dir = vmath.vector3()
	self.speed = 0
	self.lifetime = 5
	self.position = go.get_position(".")
	self.z  = self.position.z
	go.set("#sprite","color_mod",self.color_shift) 
end

function final(self)
	local s_s_max = 0.9
	local s_s_min = 0.2
	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
	sound.stop("/Sound_manager#bullet_collision_sound")
	sound.play("/Sound_manager#bullet_collision_sound",{speed = random_offset, gain = 0.2})
	particlefx.play("#enemy_bullet_destroy")
end

function update(self, dt)
	if active.cur_scene_active then 
		self.position = go.get_position(".")
		self.position.z = self.z 
		go.set_position(self.position+self.dir*self.speed * dt, ".")
	else
		go.delete()
	end
end

function fixed_update(self, dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("spawn_data") then 
		physics.set_shape("#collisionobject", "bullet", {type = physics.SHAPE_TYPE_SPHERE, diameter  = message.diameter })
		physics.set_shape("#collisionobject1", "bullet", {type = physics.SHAPE_TYPE_SPHERE, diameter  = message.diameter })
		sprite.play_flipbook("#sprite",message.type)
		if message.type == "star" then 
			self.lifetime = 10
		end

		self.dir = message.dir 
		self.speed = message.speed

		timer.delay(self.lifetime,false, function() 
			go.delete(".")
		end)
	end
	if message_id == hash("get_type") then 
		msg.post(sender,"break_wall",{dmg = 5})
	end
	if message_id == hash("player_hit") then
		go.set("#sprite","flasher",vmath.vector4(10,0,0,0))
		go.delete(".")
		msg.post(sender,"Hit_response",{data = 6767})
	end
	if message_id == hash("contact_point_response") then
		go.set("#sprite","flasher",vmath.vector4(10,0,0,0))
		go.delete(".")
		
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
