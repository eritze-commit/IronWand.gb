	local env = require("main.Scripts.eviorment_data")
	local global = require("main.GLOBAL.GLOBAL")
	local Pstate = require "main.Player_assets.Player_state_module"
	local game_state = require("main.GLOBAL.in_game")
	local upgrades = require("main.GUI.Upgrade_modules.upgrade_data_layer")
	
function init(self)
	self.pl_p = go.get_position("/Player_ROOT/Player")
	self.self_pos = go.get_position(".")
	self.last_dmg = 0
	--msg.post(".", "acquire_input_focus")
	self.next_point = 1
	self.dir = vmath.vector3()
	self.distance = vmath.vector3()
	self.speed = 40--math.random(40,50)
	self.target_pos =  vmath.vector3()
	self.max_health = 10
	self.grid_size = 16
	self.real_end = vmath.vector3()
	self.cur_pos =  vmath.vector3()
	self.name = "name"
	self.start_pos = vmath.vector3()
	self.h_flip = true 
	self.angle_transform = nil
	self.path = {}
	self.smallest = nil 
	self.best_indexes = nil
	self.index = nil
	self.buffer = nil
	self.last_visited = {}
	self.directions = nil
	self.random_delay_time =  20-math.random()
	self.t = 0
	self.can_see_player = false
	self.cur_ray_cast = nil
	self.shooting_cooldown = 3
	self.Dx = nil
	self.is_flipped = false

	self.default_tint = 1 
	self.should_flip = nil
	self.smoothed_vel = vmath.vector3()
	self.alive = false

	self.critical_hit_chance = 5 -- global.crit_chance + (upgrades.data_layer["^crit"].chance*10) 
	self.critical_hit_multiplyer = 1.5 --global.crit_multiplyer * ( 1 + upgrades.data_layer["+crit"].damage) 

	self.cur_bullet_type = nil

	self.health = math.random(10,20)

	self.active_timer = {first = false, second = false}
	
	self.path_noise = true
	self.noise_strenght = 0.5

	self.default_speed = 45

	self.knockback_dir = vmath.vector3()

	self.des_dir = vmath.vector3()

	self.bullet_speed = 81
	self.player_prediction = go.get_position("/Player_ROOT/Player")
	self.my_pos = go.get_position(".")

	self.dist_to_player = 0
	self.t = 0

	self.player_prediction =  vmath.vector3()
	self.shoot_dir = vmath.vector3()

	self.special = false

	self.min_drops = 0
	self.max_drops = 1 
	
	self.G_distance = 0
	self.random_dir = 0
	self.xy_to_d = nil
	self.random_number_slot = 0

	self.vector_transform = 0
	self.enemy_shooting_speed = 2.5

	self.noise_factor = vmath.vector3()

	self.distance_leeway = 3
	self.smoothness = 15
	self.noise_floor = 3
	self.cur_health_state = 0
	

	self.all_directions = {
		vmath.vector3(0, 0, 0),   
		vmath.vector3(0, 1, 0),    -- Up
		vmath.vector3(1, 1, 0),    -- Up-Right
		vmath.vector3(1, 0, 0),    -- Right
		vmath.vector3(1, -1, 0),   -- Down-Right
		vmath.vector3(0, -1, 0),   -- Down
		vmath.vector3(-1, -1, 0),  -- Down-Left
		vmath.vector3(-1, 0, 0),   -- Left
		vmath.vector3(-1, 1, 0),   -- Up-Left
	}

	self.directions = {
		vmath.vector3(0, 1, 0),    -- Up

		vmath.vector3(1, 0, 0),    -- Right

		vmath.vector3(0, -1, 0),   -- Down

		vmath.vector3(-1, 0, 0),   -- Left

	}
	self.modulate = { 
		fluke = 0 ,
		rush = 0 ,
		flee = 0 , 
		circle = 0 
		
	}
	self.weight_values = { 
		fluke =  math.random(),
		rush =  math.random(),
		flee =  math.random() , 
		circle =  math.random()

	}
	self.bullets = {
		{type = "tiny", speed = 90, diameter = 3 },
		{type = "medium", speed = 79, diameter = 7 },
		{type = "big", speed = 50, diameter = 13 },
		{type = "star", speed = 0.01, diameter = 6 }
	}
	self.attacks = {
		
		
	}

	self.kl = {
		{name="fluke",value = self.weight_values.fluke + self.modulate.fluke, },
		{name = "rush",value = self.weight_values.rush + self.modulate.rush},
		{name = "flee",value = self.weight_values.flee + self.modulate.flee },
		{name = "circle", value = self.weight_values.circle + self.modulate.circle }
	}
	self.r_t = {r  = 0, rand = 0 , picked = false, selected = ""}

	self.rush_is_true = false
	self.direction_slot = {}

	self.last_pos =  go.get_position("/Player_ROOT/Player")
	self.default_flash = go.set("#Main_sprite","flasher",vmath.vector4(1,0,0,0))
	self.real_vel = nil

	self.distance_to_p = nil
	self.t_blend = nil
	self.blend = nil
	self.bullet_ammount = 1 
	self.per_shot_cooldown = 0 
	self.smart_aim = true
	self.can_take_knockback = true 
	

end

local grid_size = 16

local function clear_everything()
	for y = 1, 30 do 
		for x = 1, 50 do 
			tilemap.set_tile("/Debug_map#Pathfind_map","layer1",x,y,0)
		end
	end
end

local function draw_Path(self)
	clear_everything()
	for i, ofdir in ipairs(self.path) do
		print("THIS IS THE DRAWING FUNCTION ",ofdir[1],ofdir[2])
		tilemap.set_tile("/Debug_map#Pathfind_map","layer1",math.floor(ofdir[1]),math.floor(ofdir[2]),math.random(1,4))
	end

	--path = {}
	--go.delete()
end


local function path_finder(self,cus_path)
	self.path = {}
	local player_pos_buffer = {}
	self.direction_slot = {}
	self.rush_is_true = false
	self.path_noise = true
	self.noise_strenght = 0.5
	self.next_point = 1
	--self.last_visited = {}
	self.last_visited = {}
	self.pl_p = go.get_position("/Player_ROOT/Player")
	self.self_pos = go.get_position(".")
	if self.path_noise and false then 
		self.real_end = vmath.vector3(math.floor((self.pl_p.x/self.grid_size)+self.all_directions[math.random(1,8)].x),math.floor((self.pl_p.y/self.grid_size)+self.all_directions[math.random(1,8)].y),0)
	else
		self.real_end = vmath.vector3(math.floor(self.pl_p.x/self.grid_size),math.floor(self.pl_p.y/self.grid_size),0)
	end
	
	self.cur_pos = vmath.vector3(math.floor(self.self_pos.x/grid_size),math.floor(self.self_pos.y/grid_size),0)
	self.start_pos = vmath.vector3(math.floor(self.self_pos.x/grid_size),math.floor(self.self_pos.y/grid_size),0)
	--print("REAL END ",real_end,"CUR_POS",cur_pos)
	self.buffer = {}

	--print( " PLAYER POS  =  ",self.real_end)
	
	if cus_path then 
		if not cus_path.noise then 
			self.path_noise = false
		else
			self.path_noise = true
			self.noise_strenght = cus_path.noise_strenght
		end
		
		if cus_path.path == "circle" then
			for inside = 1 , #self.all_directions do 
				player_pos_buffer[self.real_end.x+ self.all_directions[inside].x.."_"..self.real_end.y+ self.all_directions[inside].y] = true
			end 
			for i = 1, 10  do 
				self.random_number_slot = math.random(0,360) 
				
				self.vector_transform = vmath.vector3(math.cos(math.rad(self.random_number_slot)),math.sin(math.rad(self.random_number_slot)),0 )
				self.real_end = vmath.vector3(math.floor( (  self.pl_p.x + self.vector_transform.x  *  cus_path.offset) / 16 ),math.floor( (  self.pl_p.y + self.vector_transform.y  *  cus_path.offset) / 16 ),0)
				--print("REAL END ",self.real_end)
				if env.floor_tiles[self.real_end.x.."_"..self.real_end.y] 
				and not env.statue_pos[self.real_end.x.."_"..self.real_end.y] 
				and not player_pos_buffer[self.real_end.x.."_"..self.real_end.y] 
				then
					self.real_end = self.real_end
					break
				end 
			end
		elseif cus_path.path == "fluke" then 
			
			for i = 1 , #self.all_directions do 
				self.vector_transform = self.cur_pos + self.all_directions[math.random(1,#self.all_directions)] 
				if env.floor_tiles[self.vector_transform.x.."_"..self.vector_transform.y] 
				and not env.statue_pos[self.vector_transform.x.."_"..self.vector_transform.y]  then 
					self.real_end = self.vector_transform
					break
				end
				
			end
		elseif cus_path.path == "rush" then 
			self.rush_is_true = true
		
		elseif cus_path.path == "flee" then 
			
			for i = 1, 5  do 
				self.vector_transform =  vmath.normalize(self.self_pos - self.pl_p)
				self.angle_transform = math.floor(math.atan2(self.vector_transform.y,self.vector_transform.x) * (180 / math.pi))
				--print("ANGLE TRANSFORM",self.angle_transform)
				self.random_number_slot =  self.angle_transform + math.random(-80,80) 

				self.vector_transform = vmath.vector3(math.cos(math.rad(self.random_number_slot)),math.sin(math.rad(self.random_number_slot)),0 )
				self.real_end = vmath.vector3(math.floor( (  self.pl_p.x + self.vector_transform.x  *  cus_path.offset) / 16 ),math.floor( (  self.pl_p.y + self.vector_transform.y  *  cus_path.offset) / 16 ),0)
				--print("REAL END ",self.real_end)
				if env.floor_tiles[self.real_end.x.."_"..self.real_end.y] 
				and not env.statue_pos[self.real_end.x.."_"..self.real_end.y] 
				and not player_pos_buffer[self.real_end.x.."_"..self.real_end.y] 
				then
					self.real_end = self.real_end
					break
				end 
				--cus_path.offset = math.random(50,100)
			end
		end
		
		
		
	end

	for inside = 1 , 100 do 
		if self.rush_is_true then 
			self.direction_slot = self.all_directions 
		else
			self.direction_slot = self.directions
		end
		for i, ofdir in ipairs(self.direction_slot) do 
			self.G_distance = vmath.length(self.real_end - (self.cur_pos+ofdir))
			if env.floor_tiles[self.cur_pos.x+ofdir.x.."_"..self.cur_pos.y+ofdir.y] and not self.last_visited[self.cur_pos.x+ofdir.x.."_"..self.cur_pos.y+ofdir.y] and not env.statue_pos[self.cur_pos.x+ofdir.x.."_"..self.cur_pos.y+ofdir.y] then 
				table.insert(self.buffer, self.G_distance)
			else
				table.insert(self.buffer,99999999999)
			end
		end
		self.smallest = self.buffer[1]
		self.best_indexes = {1}
		self.index = 1
		
		for i = 2 , #self.buffer do 
			if self.buffer[i] < self.smallest then
				self.smallest = self.buffer[i]
				self.best_indexes = {i}
			elseif self.buffer[i] == self.smallest then 
				table.insert(self.best_indexes, i)
				end
		
			end
			if self.smallest == 99999999999 then
				break
			end
		
			self.random_dir = math.random(1,8)

			if self.path_noise and  math.random() < self.noise_strenght then 
				if  env.floor_tiles[self.cur_pos.x+self.all_directions[self.random_dir].x.."_"..self.cur_pos.y+self.all_directions[self.random_dir].y] and not env.statue_pos[self.cur_pos.x+self.all_directions[self.random_dir].x.."_"..self.cur_pos.y+self.all_directions[self.random_dir].y] then 
					self.xy_to_d = {(self.cur_pos.x+self.all_directions[self.random_dir].x) , (self.cur_pos.y+self.all_directions[self.random_dir].y) } 
					table.insert(self.path,self.xy_to_d)
				end
			end
		
			self.index = self.best_indexes[math.random(1,#self.best_indexes)]
			self.cur_pos = self.cur_pos + self.direction_slot[self.index]
			self.buffer = {}
			self.xy_to_d = {self.cur_pos.x, self.cur_pos.y} 

			if self.cur_pos.x == self.real_end.x  and self.cur_pos.y == self.real_end.y then 
				table.insert(self.path,self.xy_to_d)
				break 
			end
			self.distance = vmath.length(self.cur_pos - self.real_end)
			if self.distance <= 1 then
				table.insert(self.path,self.xy_to_d)
				break
			end

			table.insert(self.path,self.xy_to_d)
			if not self.rush_is_true then 
				self.last_visited[self.cur_pos.x.."_"..self.cur_pos.y] = true
			end
	
		end
end 

function final(self)
	if Pstate.alive then
		particlefx.play("#Enemy_death_explosion")
		msg.post("/Drop_Spawner#Drop_spawner","spawn_drop",{position = go.get_position("."), max_drop = self.max_drops, min_drop = self.min_drops})

		local s_s_max = 2
		local s_s_min = 1.5
		local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))

	
		sound.stop("/Sound_manager#break_explode_sound")
		sound.play("/Sound_manager#break_explode_sound",{speed = random_offset })
		msg.post("/global#Game_state_manager","change_state",{state = "combo"})
		msg.post("/DynamicProceduralEnemyController#Enemy_Spawner","enemy_clear_from_buffer",{id = go.get_id()})
	end


	-- if math.random(0,1) == 1 then 
	-- 	for i =1,   math.random(1,3) do 
	-- 		local x_modulatro = math.random(0,1) == 1 and -1 or 1 
	-- 		local y_modulatro = math.random(0,1) == 1 and -1 or 1 
	-- 		factory.create("/DynamicProceduralEnemyController#drop_spawn",go.get_position(".")+vmath.vector3(math.random()*x_modulatro,math.random()*y_modulatro,0)*(math.random(1,10)))
	-- 	end
	-- end
	
end


local function probability_projection(self)

		for i = 0 , 100 do
			self.r_t.r = math.random()
			self.r_t.rand = math.random(1,#self.kl)

			if self.kl[self.r_t.rand].value > self.r_t.r then
				return self.kl[self.r_t.rand].name
			end
			
		end
end
	

local function path_state_calc(self) 
	if self.can_see_player then 
		self.r_t.selected = probability_projection(self)

		if self.r_t.selected == "fluke" then 
			self.speed = self.speed * 1.3
			--self.smoothness = 100 --self.smoothness * 10
			path_finder(self  ,{noise = true , noise_strenght = 0.9, path = "fluke", offset = math.random(1,2) })
			--print("PATH FLUKE ")
			timer.delay(0.1, false, function() 
				self.speed = self.default_speed
			end)	
		elseif self.r_t.selected == "flee" then 
			path_finder(self  ,{noise = false , noise_strenght = 0, path = "flee" , offset = math.random(40,100)})
			--print("PATH FLEEEE  ")
		elseif self.r_t.selected == "circle" then 
			path_finder(self  ,{noise = true , noise_strenght = math.random()*0.5, path = "circle", offset = math.random(40,70) })
			--print("PATH CIRCLE  ")
		elseif self.r_t.selected == "rush" then 
			path_finder(self  ,{noise = false , noise_strenght = 0, path = "rush" })
			self.speed = self.speed * 1.2
			timer.delay(1, false, function() 
				self.speed = self.default_speed
			end)	
			--print("PATH RUSSH ")
		else
			path_finder(self,{noise = true, noise_strenght = math.random()*0.5 })
			--print("PATH none ")
		end
		
	else
		path_finder(self,{noise = true, noise_strenght = math.random()*0.5 })
		--print("PATH none ")
	end
	self.modulate.rush = 0
	self.modulate.circle = 0
	self.modulate.flee = 0
	self.modulate.fluke = 0
end

function update(self, dt)
	--msg.post("@render:", "draw_line", { start_point = go.get_position("."), end_point = go.get_position("/Player_ROOT/Player")+vmath.vector3(0,-5,0), color = vmath.vector4(1, 1, 1, 1) })
	--print("CAN SSEREE PLAYER ",self.can_see_player)
	--print("SELF CAN SEE PLAYER",self.can_see_player)
	if not game_state.paused then 
	self.cur_pos = go.get_position(".")
	self.last_pos = self.pl_p
	self.pl_p = go.get_position("/Player_ROOT/Player")
	
	self.Dx = self.pl_p.x - self.cur_pos.x
	--print("SELF DX ",self.Dx)
	if self.Dx ~= 0 then 
		self.should_flip = self.Dx > 0
		if self.should_flip ~= self.is_flipped and self.h_flip  then 
			sprite.set_hflip("#Main_sprite",self.should_flip)
			self.is_flipped = self.should_flip
		end
	end
	--sprite.set_hflip("#cow",self.pl_p.x > self.cur_pos.x )
	if #self.path >= 1 and self.next_point <= #self.path and self.speed > 0  then 
		
		--print("THIS IS HOW MANNY fucking paths this shit generated bruh ",#self.path)
		self.target_pos = vmath.vector3(

		(self.path[self.next_point][1]*16)+8 + self.noise_factor.x --self.dir.x * noise_factor
		,(self.path[self.next_point][2]*16)+8 + self.noise_factor.y  -- self.dir.y * noise_factor
		, self.cur_pos.z)
		
		self.desiered_dir =  vmath.normalize(self.target_pos- self.cur_pos) 
		self.dir = vmath.normalize(vmath.lerp(dt*self.smoothness,self.dir,self.desiered_dir))
		self.distance = vmath.length(self.cur_pos - self.target_pos)


		if self.distance <= (self.speed * dt) + self.distance_leeway then
			--go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD ,self.target_pos , go.EASING_LINEAR, 0.01)
			
			self.next_point = self.next_point + 1 
			self.noise_factor =  vmath.vector3(math.random(- self.noise_floor,self.noise_floor) * math.random(),math.random(-self.noise_floor,self.noise_floor) * math.random(),0)
		else
			self.cur_pos = self.cur_pos + self.dir * self.speed * dt 
		end
		
		go.set_position(self.cur_pos, ".")
		
		if self.next_point > #self.path then 
			--5clear_everything()5
			--self.path = {}
			--clear_everything()
			path_state_calc(self)

			--self.smoothness = 15
			--self.speed = 45
			--draw_Path(self)
			--path_finder(self)
		end
		
	end
	if self.smart_aim then
		self.real_vel = (self.pl_p - self.last_pos )/dt
	
		self.distance_to_p = vmath.length(self.cur_pos - self.pl_p)

		self.t_blend = (self.distance_to_p - 1 ) / (500 - 10)
		self.t_blend =  math.min(math.max(self.t_blend, 0), 1)
		--print(self.t_blend,"SELF T BLEND")
		--print("PLAYER DISTACNE ",self.distance_to_p)
		self.blend = vmath.lerp(self.t_blend, 0.05, 0.001)
		--print("BLEND ",self.blend)
		self.smoothed_vel = vmath.lerp(self.blend,self.smoothed_vel,self.real_vel)
	end
	end
	
	--print("SELF> SPEED ",self.speed)
end

function fixed_update(self, dt)
	
end

local function shooting_now(self)
		self.cur_bullet_type = self.bullets[math.random(1,#self.bullets)]
		--print("BULLETS ",self.bullets)
		
		self.player_prediction = go.get_position("/Player_ROOT/Player")
		self.my_pos = go.get_position(".")
		if self.cur_bullet_type.type ~= "star" then 
			--for index = 0 , self.bullet_ammount do 
			--	timer.delay(index*self.per_shot_cooldown, false , function() 
				
			if self.smart_aim then 
				for i = 1 , 4 do 
					self.dist_to_player =  vmath.length(self.player_prediction - self.my_pos)
					--print("ENEMEY TO PLAYER DISTACNE ", vmath.length(self.player_prediction - self.my_pos),self.dist_to_player)
					self.t = self.dist_to_player / self.cur_bullet_type.speed
					--print("self smootherd value and self t ",self.smoothed_vel, self.t,self.cur_bullet_type.speed,go.get_position("/Player_ROOT/Player"))
					self.player_prediction = go.get_position("/Player_ROOT/Player") + self.smoothed_vel * self.t
				end
			else
				self.player_prediction = go.get_position("/Player_ROOT/Player")	
			end

		for index = 0 , self.bullet_ammount do 
				timer.delay(index*self.per_shot_cooldown, false , function() 
					self.shoot_dir = vmath.normalize(self.player_prediction - self.my_pos)

					local my_bullet = factory.create("#factory", go.get_position("."),nil,{color_shift = vmath.vector4(self.default_tint,0,0,0)})
					msg.post(my_bullet,"spawn_data",{dir = self.shoot_dir , speed = self.cur_bullet_type.speed ,diameter =  self.cur_bullet_type.diameter , type = self.cur_bullet_type.type  })
				end)
			end

	--end)
	--end

	end

	if self.cur_bullet_type.type == "star" then 
		for i = 1, math.random(1,3)  do 
			timer.delay(i,false,function() 
				self.shoot_dir = vmath.normalize(self.player_prediction - go.get_position("."))
				local my_bullet = factory.create("#factory", go.get_position("."))
				msg.post(my_bullet,"spawn_data",{dir = go.get_position(".") , speed = 0 ,diameter =  self.cur_bullet_type.diameter , type = self.cur_bullet_type.type  })
				end)
			end

end
	
	
end	
	
function on_message(self, message_id, message, sender)

	if self.alive then
	if message_id == hash("retrun_of_contact_bullet") then 
	--	print("RETURNED CONTACT ")
		self.knockback_dir = vmath.normalize(message.bullet_dir )
		self.knockback_dir.z = 0

		self.modulate.rush = -0.5
		self.modulate.circle = -0.5

		self.modulate.flee = 0.5
		self.modulate.fluke = 0.5
		--print("self knowback SELF KNOWBACK",self.knockback_dir,self.cur_pos+ (self.knockback_dir * 0.5))
		go.set("#Main_sprite","flasher",vmath.vector4(10,0,0,0))
		sound.stop("/Sound_manager#Hit_sounds")
		sound.play("/Sound_manager#Hit_sounds",{speed =  0.8 + (math.random() * (1.2 -  0.8)) })
		if self.can_take_knockback == true then 
		
			go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, go.get_position(".")+ (self.knockback_dir * math.random() * 5), go.EASING_INBOUNCE, 0.02, 0, function() 
				-- go.set("#Main_sprite","flasher",vmath.vector4(1,0,0,0))
			end)
			
		end
		timer.delay(0.05, false ,  function() 
				go.set("#Main_sprite","flasher",vmath.vector4(1,0,0,0))
			end)
		if math.random(0,100) < ( self.critical_hit_chance + upgrades.data_layer["^crit"].chance * 10 ) then
			self.health = self.health - message.dmg * ( self.critical_hit_multiplyer * ( 1 + upgrades.data_layer["+crit"].damage ))
			self.last_dmg = message.dmg
		--	print("took damage ")
			factory.create("/DynamicProceduralEnemyController#numerical_facotry",go.get_position("."),nil,{value = message.dmg * (self.critical_hit_multiplyer * ( 1 + upgrades.data_layer["+crit"].damage)), special = vmath.vector4(1,0,1,1)})
		else
			self.health = self.health - message.dmg
			self.last_dmg = message.dmg
			--print("took damage ",factory.create("/DynamicProceduralEnemyController#numerical_facotry",go.get_position("."),nil,{value = message.dmg , special = vmath.vector4(1,1,1,1)}))
			factory.create("/DynamicProceduralEnemyController#numerical_facotry",go.get_position("."),nil,{value = message.dmg , special = vmath.vector4(1,1,1,1)})
		end
		if self.health <= self.max_health / 3 and self.cur_health_state == 1 then
			self.cur_health_state = 2
			sprite.play_flipbook("#Main_sprite",self.name.."_"..2)
		elseif  self.health <= ( self.max_health / 3 )* 2  and  self.cur_health_state == 0 then
			sprite.play_flipbook("#Main_sprite",self.name.."_"..1)
			self.cur_health_state = 1
		end

		if self.health <= 0  then 
			-- if math.random(0,1) == 1 then 
			-- 	for i =1,   math.random(1,3) do 
			-- 		local x_modulatro = math.random(0,1) == 1 and -1 or 1 
			-- 		local y_modulatro = math.random(0,1) == 1 and -1 or 1 
			-- 		factory.create("/DynamicProceduralEnemyController#drop_spawn",go.get_position(".")+vmath.normalize(vmath.vector3(math.random()*x_modulatro,math.random()*y_modulatro,0))*(math.random(10,30)))
			-- 	end
			-- 	local s_s_max = 0.5
			-- 	local s_s_min = 0.1
			-- 	local random_offset =  s_s_min + (math.random() * (s_s_max -  s_s_min))
			-- 	sound.stop("/Sound_manager#pickup_sfx")
			-- 	sound.play("/Sound_manager#pickup_sfx",{speed =  random_offset, gain  = 0.5})
			-- end
		if self.alive == true  then	
			self.alive = false 
		if upgrades.data_layer["shrapnel death"].chance >= math.random(1,100) then
			for i = 0 ,  upgrades.data_layer["shrapnel death"].shrapnel do 
			local x_mod = math.random() < 0.5 and -1 or 1 
			local y_mod = math.random() < 0.5 and -1 or 1 
			factory.create("/global#shrapnel_spawn",go.get_position(".") ,vmath.quat(0,0,math.random(),0) ,{speed = 200  , dir = vmath.vector3(math.random()*x_mod,math.random()*y_mod,0)  , dmg = self.last_dmg / (3/( 1 +   upgrades.data_layer["-dmg loss"].loss )) })
		end
		end
			
			local enemy_death = factory.create("/global#enemy_death",go.get_position(".") ) 
			msg.post(enemy_death,"sprite_change",{sprite = self.name,dir = self.knockback_dir, shading = self.default_tint }) 
			go.delete()
		end
		end
		
		--self.dir = vmath.normalize(vmath.lerp(0.9,self.dir,(self.knockback_dir/-1) + vmath.vector3(math.random(-50,50),math.random(-50,50),0)))
		
	end
	end

	if message_id == hash("start_path") then 
		self.default_speed = message.speed 
		self.speed = message.speed 
		self.health = message.health
		self.max_health =  message.health
		self.h_flip = message.h_flip
		self.bullets = message.bullets 
		self.weight_values = message.weight_values
		self.special = message.special
		self.enemy_shooting_speed = message.shooting_speed
		self.bullet_ammount = message.bullet_ammount
		self.per_shot_cooldown = message.per_shot_cooldown 
		self.smart_aim = message.smart_aim
		self.can_take_knockback = message.knockback

		msg.post("/global#Timer_squeduler","add_timer",{data = {script = go.get_id(), type = "enemy_spawn" , time = global.enemy_spawn_delay_scalar*message.random_module, optional = message.name }})
		
			
		
	end 
	if message_id == hash("timer_end") then
		if message.type == "enemy_spawn" then
			if not self.special then 
				local s_s_max = 0.1
				local s_s_min = 0
				local neg_mod = math.random(0,1) == 0 and 1 or -1  
				self.default_tint =  s_s_min + (math.random() * (s_s_max -  s_s_min))
				self.default_tint = self.default_tint  * neg_mod
				go.set("#Main_sprite","color_mod",vmath.vector4(self.default_tint,0,0,0))
			else
				local s_s_max = 0.2
				local s_s_min = 0.19
				local neg_mod = math.random(0,1) == 0 and 1 or -1  
				self.default_tint =  s_s_min + (math.random() * (s_s_max -  s_s_min))
				self.default_tint =	self.default_tint  * neg_mod
				go.set("#Main_sprite","color_mod",vmath.vector4(self.default_tint,0,0,0))
				--self.default_flash = vmath.vector4( 1 + self.default_tint ,0,0,0 )
				--go.set("#Main_sprite","flasher",self.default_flash)
				self.health = self.health * 2 
				self.bullet_ammount = self.bullet_ammount + math.random(1,3)
				self.max_drops = math.random(2,5)
				self.min_drops = 2
			end
			particlefx.play("#enemy_spawn")
			self.alive = true
		self.name = message.optional
		sprite.play_flipbook("#Main_sprite",message.optional)
		path_finder(self,{noise = false})

		timer.delay(  math.random() + self.enemy_shooting_speed,true,function() 
			if self.can_see_player then 
				if not game_state.paused then 
				particlefx.stop("#Ring_Particle")
				particlefx.play("#Ring_Particle")
				timer.delay(0.3, false, function() 
						shooting_now(self)
					end)	
				end
			
				
			end
	end)
		
		timer.delay(0.2, true , function() 
			physics.raycast_async(go.get_position("."), go.get_position("/Player_ROOT/Player")+vmath.vector3(0,-5,0),{hash("entity"),hash("wall")})
		end)
		
		timer.delay(self.random_delay_time, true , function() 
			if not  self.can_see_player  then 
				path_state_calc(self) 
			end
			--path_finder(self)
			--draw_Path(self)
		end)	
		
		end
	end
	if message_id == hash("ray_cast_response") then 
		--print("RAY CAST GETTER ",message.id)
		if message.id == hash("/Player_ROOT/Player") then 
			self.can_see_player = true
		else 
			self.can_see_player = false
		end
	end
	-- ss
	if message_id == hash("trigger_response") and self.alive then 
		if message.other_group == hash("entity")  then
			msg.post(message.other_id, "contact_by_bullet", {megage = true})
		end
	end
	
	if message_id ==  hash("contact_point_response") and self.alive then
		if message.other_group == hash("entity") then
			msg.post(message.other_id, "contact_by_bullet", {megage = true})
			--print("YES THIS RAN ")
		end
		if message.other_group == hash("wall") then
			if 	message.distance > 0 then 
				--go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD ,self.cur_pos+message.normal, go.EASING_INOUTSINE, 0.1)
				self.into_wall = vmath.dot(self.dir,message.normal) * message.normal
				self.dir = self.dir - self.into_wall	
				go.set_position(go.get_position(".")+self.dir * 1 , ".")
				
				
				end
		end
	end

end

local can_press = true

function on_input(self, action_id, action)
	if action_id == hash("clear_nodes") then 
		if can_press then 
			can_press = false
			--path_finder(self,{noise = false , noise_strenght = 0.2, path = "circle", offset = math.random(50,65) })

			timer.delay(0.1 ,false,function() 
				can_press = true
				draw_Path(self)
			--self.pl_p = go.get_position("/Player_ROOT/Player")
			
			end)
		end
	end

end

function on_reload(self)

end
