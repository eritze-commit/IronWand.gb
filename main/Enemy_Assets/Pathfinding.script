local path = {}

local function Path_finder()
	local start_pos = vmath.vector3(300,180,0)
	local e_p = go.get_position("/Player")
	local real_end = vmath.vector3(math.floor(e_p.x),math.floor(e_p.y),0)
	local cur_pos = vmath.vector3(300,180,0)
	local buffer = {}
	local directions = {
		vmath.vector3(0, 1, 0),   -- Up 
		vmath.vector3(1, 0, 0),   -- Right 
		vmath.vector3(0, -1, 0),  -- Down 
		vmath.vector3(-1, 0, 0),  -- Left 
	}
	for indexes = 0, 200 do 
		for i, ofdir in ipairs(directions) do 
			local G_distance = vmath.length(real_end - (cur_pos+ofdir))
			--local H_distance =  vmath.length(start_pos - (cur_pos+ofdir))
			--local F_distance = G_distance + H_distance
			--print("F distance = "..F_distance)
			table.insert(buffer,G_distance)
			--print("table contents "..buffer[i])
		end
		local smallest = buffer[1]
		local index = 1
		for i = 2 , #buffer do 
			if buffer[i] <= smallest then
				smallest = buffer[i]
				index = i
			end
		end
		cur_pos = cur_pos + directions[index]
		buffer = {}
		local xy_to_d = {cur_pos.x, cur_pos.y} 
		table.insert(path,xy_to_d)
	end
end

local function copy_path(tbl)
	local t = {}
	for i = 1, #tbl do
		t[i] = {tbl[i][1], tbl[i][2]}
	end
	return t
end

local function Draw_Path()
		local old_path = copy_path(path)   -- make a snapshot

		
		Path_finder()

		
		for i, ofdirs in ipairs(old_path) do
			tilemap.set_tile("#Pathfind_map","layer1",ofdirs[1],ofdirs[2],0)
		end

		
		for i, ofdir in ipairs(path) do
			tilemap.set_tile("#Pathfind_map","layer1",ofdir[1],ofdir[2],1)
		end

	
		path = {}

end



