function on_message(self, message_id, message, sender)
	if message_id == hash("timer_end") then 
		if message.type == "destroy" then
			go.delete(".")
		end
	end
	if message_id == hash("collision_response") then
		go.cancel_animations(".","position")

	end
	if message_id == hash("sprite_change") then
		msg.post("/global#Timer_squeduler","add_timer",{data = {script = go.get_id(), type = "destroy" , time = 30, optional = 0 }})
		local from = go.get_position(".")
		local rand_value =  math.random(20,50)
		local to = go.get_position(".")+ (message.dir*rand_value )
		local raycast = physics.raycast(from , to ,{ hash("wall") } )
		if raycast ~= nil then
			to = raycast.position 
			--pprint("to ",raycast)
		end
		sprite.play_flipbook("#sprite",message.sprite.."_death")
		go.set("#sprite","color_mod",vmath.vector4(message.shading,0,0,0))
		go.animate( ".", "position",go.PLAYBACK_ONCE_FORWARD, to ,go.EASING_OUTEXPO ,1)
	end
end

