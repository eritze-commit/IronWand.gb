local enemy_state = require("main.Player_assets.G-UNZ.Hud_state")
local env = require("main.Scripts.eviorment_data")
local enemy_data = require("main.Enemy_Assets.enemy_data")
local Pstate = require "main.Player_assets.Player_state_module"
local global = require  "main.GLOBAL.GLOBAL"


local cur_wave  = 0
local max_waves = 3

local buffer_of_enemies = {}



--		"slime","batorb","skull"}
local function Node_Placer()
	if not Pstate.alive then
		return
	end
	cur_wave = cur_wave + 1 
	local minimum_enemies = 2 
	enemy_state.enemy_cur_wave = cur_wave
	local enemies_spawned = 0 
	local enemies_spawned_this_round = 0
--	global.expo_decay = 1 * (1 - (2.71828^-0.07)^ math.min(100,0) )
	local enmey_max_buffer =   math.floor( 1 + global.floor_t * 2 + cur_wave * (global.floor_t * 3 ) + 0.5 )
--	local enmey_max_buffer = 1 +  math.floor( global.floor_t * 2 + 0.5)  +  math.floor( cur_wave * (global.floor_t * 3 ) + 0.5 )
	--local enmey_max_buffer = 1 +  math.floor( global.expo_decay * 8 )  +   math.floor( ( cur_wave * (global.expo_decay * 9 ) ) ) --2 +  math.floor( global.expo_decay * 11 )  +   math.floor( ( cur_wave * (global.expo_decay * 5 ) ) )
	--print("tried spawing enemy",enmey_max_buffer,"global expo decay ", global.expo_decay, "cur wave ", cur_wave) 
	while true do 
	for y = 0, 23 do 
		for x = 0, 37 do 
			if env.floor_tiles[x.."_"..y]  then
				if not env.statue_pos[x.."_"..y ] then 
					if math.random(1,25) == 1  then 
						local random_enemy = enemy_data:pick_new_enemy()
						if Pstate.alive then
						local  new_enemy = factory.create("/DynamicProceduralEnemyController#factory", vmath.vector3((x*16)+8,(y*16)+8,1))
						msg.post(new_enemy, "start_path", {
							name = enemy_data.enemies[random_enemy].name ,
							health = ( enemy_data.enemies[random_enemy].health / global.health_divide ) * global.enemie_floor_hp_scale ,
							special =  math.random() < 0.025	  ,
							 --0.025  ,
							smart_aim = enemy_data.enemies[random_enemy].smart_aim,
							knockback = enemy_data.enemies[random_enemy].knockback,
							h_flip = enemy_data.enemies[random_enemy].h_flip,
							hitbox_diameter = enemy_data.enemies[random_enemy].hitbox_diameter,
							x_ray = enemy_data.enemies[random_enemy].x_ray
							
						, random_module = math.random()})
						table.insert(buffer_of_enemies,new_enemy)
						enemies_spawned = enemies_spawned + 1 
						--print("NODE PLACED AT ",vmath.vector3((x*16)+8,(y*16)+8,1))5
					end 
					end
				end
				if enemies_spawned >= enmey_max_buffer then 
					break
				end
			end
			if enemies_spawned >= enmey_max_buffer then 
				break
			end
		end
		if enemies_spawned >= enmey_max_buffer then 
			break
		end
	end
	if enemies_spawned >= enmey_max_buffer then 
		break
	end
	end
	enemy_state.enemy_max_in_lvl = enemies_spawned
	enemy_state.enemy_cur_alive = #buffer_of_enemies
end

local function clear_everything()
	for y = 1, 30 do 
		for x = 1, 100 do 
			tilemap.set_tile("/PathFinder#Pathfind_map","layer1",x,y,0)
		end
	end
end
function init(self)
	--msg.post(".", "acquire_input_focus")
	self.pl_p = go.get_position("/Player_ROOT/Player")
end
-- 
-- function final(self)
-- end
-- function update(self, dt)
-- end
local enemy_spawn_que = {}
function on_message(self, message_id, message, sender)
	if message_id == hash("enemy_reset") then 
		Node_Placer()
		
	end
	if message_id == hash("clear_enemies") then 
		for i = #buffer_of_enemies, 1, -1 do
			go.delete(buffer_of_enemies[i])
			table.remove(buffer_of_enemies, i)
		end
		--print("BUFFER OF ENEIEMES",#buffer_of_enemies)
		cur_wave = 0 
		buffer_of_enemies = {}
		enemy_state.enemy_max_in_lvl = 0
		enemy_state.enemy_cur_alive = 0
		enemy_state.enemy_cur_wave = 0 
--		enemy_spawn_next = false
	end
	if message_id == hash("enemy_clear_from_buffer") and Pstate.alive  then 
		for i = #buffer_of_enemies, 1, -1 do 
			if buffer_of_enemies[i] == message.id then 
				table.remove(buffer_of_enemies ,i)
			end
		end
		enemy_state.enemy_cur_alive = #buffer_of_enemies
		if #buffer_of_enemies <= 0 and Pstate.alive then 
			if cur_wave >= max_waves then 
				cur_wave = 0 
				timer.delay(0.1,false,function() 
					if Pstate.alive  then
						msg.post("/global#Game_state_manager","change_state",{state = "up_floor"})
					end
				
				end)
				enemy_state.enemy_cur_wave = cur_wave
			else
				timer.delay(2,false,function() 
						Node_Placer()
					
				end)
			end
			
		end
	end
end

local can_press = true 
function on_input(self, action_id, action)
	if action_id == hash("Enem_node") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			msg.post("/global#Game_state_manager","change_state",{state = "up_floor"})
			-- self.pl_p = go.get_position("/Player_ROOT/Player")
			
			-- --local new_enemy = factory.create("/DynamicProceduralEnemyController#factory",vmath.vector3(math.floor(self.pl_p.x),math.floor(self.pl_p.y),10))
			-- --table.insert(enemy_buffer,new_enemy)
			
			-- Node_Placer()
			
			-- print("RAN")
		end	
	end
	if action_id == hash("_clear_nodes") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			--clear_everything()
			--print("CLEARNER")
		end	
	end
end
