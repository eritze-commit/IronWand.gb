function on_message(self, message_id, message, sender)
	if message_id == hash("enemy_reset") then 
		Node_Placer()
	end
	if message_id == hash("enemy_clear_from_buffer") then 
		for i = #buffer_of_enemies, 1, -1 do 
			if buffer_of_enemies[i] == message.id then 
				table.remove(buffer_of_enemies ,i)
			end
		end
		enemy_state.enemy_cur_alive = #buffer_of_enemies
		if #buffer_of_enemies <= 0 then 
			if cur_wave >= max_waves then 
				cur_wave = 0 
				enemy_state.enemy_cur_wave = cur_wave
				enemy_state.map_cur_floor = enemy_state.map_cur_floor + 1 
				timer.delay(10,false,function() 
					Node_Placer()
				end)
				timer.delay(2,false,function() 
					msg.post("/GUI_ON_TOP#hud","map_info",{floor = 1 })
				end)

				timer.delay(3,false,function() 
					msg.post("/Map#Auto_Tiler","asm",{map = 1})
				end)
			else
				timer.delay(2,false,function() 
					Node_Placer()
				end)
			end
			
		end
	end
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

local can_press = true 
function on_input(self, action_id, action)
	if action_id == hash("Enem_node") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			self.pl_p = go.get_position("/Player_ROOT/Player")
			
			--local new_enemy = factory.create("/DynamicProceduralEnemyController#factory",vmath.vector3(math.floor(self.pl_p.x),math.floor(self.pl_p.y),10))
			--table.insert(enemy_buffer,new_enemy)
			
			Node_Placer()
			
			print("RAN")
		end	
	end
	if action_id == hash("_clear_nodes") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			--clear_everything()
			print("CLEARNER")
		end	
	end
	
	-- Add input-handling code here. The game object this script is attached to
	-- must have acquired input focus:
	--
	--    msg.post(".", "acquire_input_focus")
	--
	-- All mapped input bindings will be received. Mouse and touch input will
	-- be received regardless of where on the screen it happened.
	-- Learn more: https://defold.com/manuals/input/
	-- Remove this function if not needed
end

