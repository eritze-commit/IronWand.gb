local enemy_state = require("main.Player_assets.G-UNZ.Hud_state")

local env = require("main.Scripts.eviorment_data")

local name_list = {"cow","slime","batorb","skull"}

local enmey_max_buffer = 5
local enemy_spawn_delay = 3

local cur_enemy_buffer = 0
local default_spawn_delay = 3

local cur_wave  = 0
local max_waves = 3

local buffer_of_enemies = {}

local function Node_Placer()
	cur_wave = cur_wave + 1 
	enemy_state.enemy_cur_wave = cur_wave
	local enemies_spawned = 0 
	local enemies_spawned_this_round = 0
	local enmey_max_buffer =  math.random(3,7)
	for i = 1, 5 do 
	for y = 0, 23 do 
		for x = 0, 37 do 
			if env.floor_tiles[x.."_"..y]  then
				if not env.statue_pos[x.."_"..y ] then 
					if math.random(1,25) == 1  then 
						local  new_enemy = factory.create("/DynamicProceduralEnemyController#factory", vmath.vector3((x*16)+8,(y*16)+8,1))
						msg.post(new_enemy, "start_path", {delay_time = 3, name = name_list[math.random(1,#name_list)] , random_module = math.random()})
						table.insert(buffer_of_enemies,new_enemy)
						enemies_spawned = enemies_spawned + 1 
						--print("NODE PLACED AT ",vmath.vector3((x*16)+8,(y*16)+8,1))5
					end 
				end
				if enemies_spawned >= enmey_max_buffer then 
					break
				end
			end
			if enemies_spawned >= enmey_max_buffer then 
				break
			end
		end
		if enemies_spawned >= enmey_max_buffer then 
			break
		end
	end
	if enemies_spawned >= enmey_max_buffer then 
		break
	end
	end
	enemy_state.enemy_max_in_lvl = enemies_spawned
	enemy_state.enemy_cur_alive = #buffer_of_enemies
end

local function clear_everything()
	for y = 1, 30 do 
		for x = 1, 100 do 
			tilemap.set_tile("/PathFinder#Pathfind_map","layer1",x,y,0)
		end
	end
end

