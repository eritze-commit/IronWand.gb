local can_press = true 
function on_input(self, action_id, action)
	if action_id == hash("Enem_node") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			self.pl_p = go.get_position("/Player_ROOT/Player")
			
			--local new_enemy = factory.create("/DynamicProceduralEnemyController#factory",vmath.vector3(math.floor(self.pl_p.x),math.floor(self.pl_p.y),10))
			--table.insert(enemy_buffer,new_enemy)
			
			Node_Placer()
			
			print("RAN")
		end	
	end
	if action_id == hash("_clear_nodes") then 
		if  can_press then 
			can_press = false 
			timer.delay(0.1, false, function() 
				can_press = true
			end)
			--clear_everything()
			print("CLEARNER")
		end	
	end
	
	-- Add input-handling code here. The game object this script is attached to
	-- must have acquired input focus:
	--
	--    msg.post(".", "acquire_input_focus")
	--
	-- All mapped input bindings will be received. Mouse and touch input will
	-- be received regardless of where on the screen it happened.
	-- Learn more: https://defold.com/manuals/input/
