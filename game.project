[bootstrap]
main_collection = /main/main.collectionc
render = /main/Shader_adjecent_files/Post_processing/Bloom_renderer.renderc

[script]
shared_state = 1

[display]
width = 620
height = 480
dynamic_orientation = 0
fullscreen = 0
vsync = 1
display_device_info = 0
update_frequency = 100

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = IronWand.gb
minimum_log_level = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest
texture_profiles = /builtins/graphics/default.texture_profiles

[physics]
gravity_y = 0.0
use_fixed_timestep = 1
type = 2D
allow_dynamic_transforms = 1
debug = 0
max_collision_object_count = 256
scale = 1.0
max_collisions = 128

[profiler]
track_cpu = 0

[sound]
use_thread = 1

[particle_fx]
max_count = 256
max_emitter_count = 128

[sprite]
max_count = 256

[engine]
fixed_update_frequency = 100

[input]
use_accelerometer = 0

[native_extension]
app_manifest = /main/native_extension.appmanifest

[box2d]
sub_step_count = 4

[label]
max_count = 128

